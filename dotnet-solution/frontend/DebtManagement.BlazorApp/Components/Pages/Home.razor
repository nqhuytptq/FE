@page "/"
@using DebtManagement.Shared.DTOs
@using DebtManagement.Application.Interfaces
@using DebtManagement.BlazorApp.Components.Features.Auth
@using DebtManagement.BlazorApp.Components.Features.Admin
@using DebtManagement.BlazorApp.Components.Features.Documents
@using DebtManagement.BlazorApp.Components.Features.Reports
@using DebtManagement.BlazorApp.Components.Layout
@using static DebtManagement.BlazorApp.Models.DebtUiHelpers
@inject BlazorSession Session
@inject IDebtDocumentService DocService

<PageTitle>VCB Debt Management — Quản lý hồ sơ văn bản nợ</PageTitle>

@if (!Session.IsInitialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <span class="spinner-border text-success"></span>
    </div>
}
else if (!Session.IsAuthenticated)
{
    <LoginView OnLoginSuccess="LoadAsync" />
}
else
{
    <TopBar ShowUsers="showUsers"
            ShowSupReport="showSupReport"
            MyActionCount="MyActionCount"
            OnToggleCreateModal="() => showCreateModal = !showCreateModal"
            OnToggleUsers="() => { showUsers = !showUsers; if (showUsers) showSupReport = false; }"
            OnToggleSupReport="() => { showSupReport = !showSupReport; if (showSupReport) showUsers = false; }"
            OnSelectMyActions='() => { showUsers = false; showSupReport = false; quickTab = "mine"; filterStatus = ""; }'
            OnLogout="LogoutAsync" />

    @if (showUsers)
    {
        <UserManagementView />
    }
    else if (showSupReport)
    {
        <SupReportView OnSelectDocument="id => selectedDocId = id" />
    }
    else
    {
        <DocumentDashboard Docs="docs"
                           @bind-ShowCreateModal="showCreateModal"
                           @bind-QuickTab="quickTab"
                           @bind-FilterStatus="filterStatus"
                           OnReloadRequested="LoadAsync"
                           OnSelectDocument="id => selectedDocId = id" />
    }
}

<DocumentDetailDrawer DocumentId="selectedDocId"
                      OnDocumentChanged="LoadAsync"
                      OnClose="() => selectedDocId = null" />

@code {
    bool showCreateModal;
    bool showUsers;
    bool showSupReport;
    string filterStatus = "";
    string quickTab = "mine";
    List<DebtDocumentDto> docs = new();
    Guid? selectedDocId;

    int MyActionCount => docs.Count(d =>
        IsActionRequiredForUser(d, Session.CurrentUser?.Id, Session.CurrentUser?.DepartmentCode, Session.CurrentUser?.Role));

    protected override async Task OnInitializedAsync()
    {
        await Session.InitializeAsync();
        if (Session.IsAuthenticated)
            await LoadAsync();
    }

    async Task LoadAsync()
    {
        if (Session.CurrentUser != null)
        {
            if (Session.CurrentUser.Role == "admin")
                quickTab = "all";
            docs = (await DocService.GetAllAsync(null, null, null, Session.CurrentUser.Id)).ToList();
        }
    }

    async Task LogoutAsync()
    {
        await Session.LogoutAsync();
        docs.Clear();
        selectedDocId = null;
        showUsers = false;
        showSupReport = false;
    }
}