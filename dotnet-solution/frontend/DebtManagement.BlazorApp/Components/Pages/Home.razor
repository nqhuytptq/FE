@page "/"
@inject BlazorSession Session
@inject IDebtDocumentService DocService
@inject IUserService UserService

<PageTitle>VCB Quản lý hồ sơ</PageTitle>

@if (!Session.IsInitialized)
{
    <div class="d-flex justify-content-center align-items-center min-vh-50"><span class="spinner-border text-primary"></span></div>
}
else if (!Session.IsAuthenticated)
{
    <div class="container mt-5"><div class="row justify-content-center"><div class="col-md-5 card p-4 shadow">
        <h3 class="text-primary mb-3">Đăng nhập VCB</h3>
        <input class="form-control mb-2" @bind="email" placeholder="Email" />
        <input type="password" class="form-control mb-3" @bind="password" placeholder="Mật khẩu" />
        @if (loginError != null) { <div class="alert alert-danger">@loginError</div> }
        <button class="btn btn-primary w-100" @onclick="LoginAsync">Đăng nhập</button>
    </div></div></div>
}
else
{
    <div class="d-flex justify-content-between mb-3">
        <div><h4 class="text-primary mb-0">Quản lý hồ sơ văn bản nợ</h4><small class="text-muted">@Session.CurrentUser?.Name | @Session.CurrentUser?.DepartmentCode | @Session.CurrentUser?.Role</small></div>
        <div class="d-flex gap-2">
            @if (Session.CurrentUser?.Role == "admin") { <button class="btn btn-sm btn-outline-secondary" @onclick="ToggleUsers">@(showUsers ? "Hồ sơ" : "Người dùng")</button> }
            <button class="btn btn-sm btn-outline-danger" @onclick="Logout">Đăng xuất</button>
        </div>
    </div>

    @if (showUsers)
    {
        <div class="card mb-3"><div class="card-header fw-bold">Quản lý người dùng</div>
        <table class="table mb-0"><thead><tr><th>Tên</th><th>Email</th><th>Phòng</th><th>Role</th><th>Hoạt động</th></tr></thead><tbody>
        @foreach (var u in allUsers) { <tr><td>@u.Name</td><td>@u.Email</td><td>@u.DepartmentName</td><td>@u.Role</td><td>@(u.IsActive ? "✅" : "❌")</td></tr> }
        </tbody></table></div>
    }
    else
    {
        @* === Form tạo hồ sơ mới (NV PKH) === *@
        @if (Session.CurrentUser?.DepartmentCode == "PKH" && Session.CurrentUser?.Role == "staff")
        {
            <div class="card mb-3 border-primary"><div class="card-header text-primary fw-bold">Tạo hồ sơ mới</div><div class="card-body">
                @if (createError != null) { <div class="alert alert-danger">@createError</div> }
                <div class="row g-2 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Tên khách hàng <span class="text-danger">*</span></label>
                        <input class="form-control" @bind="newName" placeholder="Nhập tên khách hàng" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Số điện thoại</label>
                        <input class="form-control" @bind="newPhone" placeholder="Nhập SĐT" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Ngày phát sinh</label>
                        <input class="form-control" @bind="newIssue" placeholder="yyyy-MM-dd" disabled />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Hạn thanh toán</label>
                        <input class="form-control" @bind="newDue" placeholder="yyyy-MM-dd" />
                    </div>
                </div>
                <div class="form-check mb-2"><input class="form-check-input" type="checkbox" @bind="newHasDebt" id="hd" /><label class="form-check-label fw-semibold" for="hd">Có chứng từ nợ</label></div>
                @if (newHasDebt)
                {
                    @if (newItems.Count > 0) { <label class="form-label small fw-semibold mb-1">Danh sách tên chứng từ nợ</label> }
                    @foreach (var it in newItems)
                    {
                        <div class="input-group mb-1"><input class="form-control" @bind="it.ItemName" placeholder="Nhập tên CT nợ" /><button class="btn btn-outline-danger" @onclick="() => newItems.Remove(it)">X</button></div>
                    }
                    <button class="btn btn-sm btn-outline-primary" @onclick="() => newItems.Add(new CreateDebtItemRequest())">+ Thêm CT</button>
                }
                <div class="mt-2"><button class="btn btn-primary" @onclick="CreateDoc">Tạo hồ sơ</button></div>
            </div></div>
        }

        @if (actionError != null)
        {
            <div class="alert alert-danger alert-dismissible fade show py-2" role="alert">
                <strong>Thao tác thất bại:</strong> @actionError
                <button type="button" class="btn-close py-2" @onclick="() => actionError = null"></button>
            </div>
        }

        @* === Chi tiết hồ sơ === *@
        @if (selected != null)
        {
            var pkhItems = selected.DebtItems.Where(x => (x.SourceDepartmentCode ?? "PKH") == "PKH").ToList();
            var pqlnItems = selected.DebtItems.Where(x => x.SourceDepartmentCode == "PQLN").ToList();
            var canAnyWorkflowAction = CanApprovePkh || CanReceivePqln || CanSubmitPqln || CanApprovePqln || CanReceivePdv || CanPostEntry || CanApprovePdv;
            var completedItemsCount = selected.DebtItems.Count(IsItemFullyCompleted);

            <div class="card border-primary shadow-sm mb-4">
                @* Header *@
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="fw-bold fs-6">@selected.DocumentNumber</span>
                        <span class="badge bg-light text-primary">@selected.CurrentDepartmentName</span>
                        <span class="badge @StatusBadgeClass(selected.Status) border border-white">@StatusLabel(selected.Status)</span>
                    </div>
                    <button class="btn btn-sm btn-light fw-semibold" @onclick="Close">✕ Đóng</button>
                </div>

                <div class="card-body">
                    @* 1. Khối thông tin tổng quan 3 cột *@
                    <div class="row g-3 p-2 mb-3 rounded bg-light border mx-0 small">
                        <div class="col-md-4">
                            <div class="text-muted">Khách hàng</div>
                            <div class="fw-bold fs-6 text-dark">@selected.CustomerName</div>
                            @if (!string.IsNullOrWhiteSpace(selected.CustomerPhone))
                            {
                                <div class="text-muted">SĐT: <span class="text-body">@selected.CustomerPhone</span></div>
                            }
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted">Cán bộ phụ trách</div>
                            <div>PKH tạo: <b>@(selected.CreatedByUserName ?? "—")</b></div>
                            <div>PQLN nhận: <b>@(selected.PqlnReceiverName ?? "Chưa tiếp nhận")</b></div>
                            @if (!string.IsNullOrWhiteSpace(selected.PdvReceiverName))
                            {
                                <div>PDV nhận: <b>@selected.PdvReceiverName</b></div>
                            }
                        </div>

                        <div class="col-md-4">
                            <div class="text-muted">Mốc thời gian & Tiến độ</div>
                            <div>Hạn thanh toán: <b class="text-danger">@FormatDate(selected.DueDate)</b></div>
                            <div>Cập nhật: <b>@FormatFullVnTime(selected.UpdatedAt)</b></div>
                            <div>
                                Chứng từ nợ:
                                @if (selected.DebtItems.Count == 0)
                                {
                                    <b>Không có</b>
                                }
                                else
                                {
                                    <b>@completedItemsCount/@selected.DebtItems.Count đã hoàn tất</b>
                                }
                            </div>
                        </div>
                    </div>

                    @* 2. Thanh thao tác / Phê duyệt đưa lên trên cùng *@
                    @if (canAnyWorkflowAction)
                    {
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 mb-3 rounded border border-warning bg-warning-subtle">
                            <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
                                <span class="fw-bold text-dark small">Thao tác xử lý:</span>
                                @if (CanApprovePkh || CanApprovePqln || CanApprovePdv || CanSubmitPqln || CanPostEntry)
                                {
                                    <input class="form-control form-control-sm" style="max-width: 340px;"
                                           @bind="approvalNote"
                                           placeholder="Nhập ghi chú duyệt / xử lý (không bắt buộc)..." />
                                }
                            </div>
                            <div class="d-flex flex-wrap gap-2">
                                @if (CanApprovePkh)
                                {
                                    <button class="btn btn-sm btn-success fw-semibold px-3" disabled="@isSubmitting"
                                            @onclick='() => OpenApproveConfirm("PKH", "Xác nhận duyệt hồ sơ (PKH)", "Sau khi duyệt, hồ sơ sẽ được chuyển sang Phòng Quản lý nợ (PQLN).")'>
                                        ✓ Duyệt PKH
                                    </button>
                                }

                                @if (CanReceivePqln) { <button class="btn btn-sm btn-primary fw-semibold px-3" disabled="@isSubmitting" @onclick="ReceivePqln">Tiếp nhận PQLN</button> }
                                @if (CanSubmitPqln) { <button class="btn btn-sm btn-primary fw-semibold px-3" disabled="@isSubmitting" @onclick="SubmitPqln">Đẩy SUP PQLN</button> }
                                @if (CanApprovePqln)
                                {
                                    <button class="btn btn-sm btn-success fw-semibold px-3" disabled="@isSubmitting"
                                            @onclick='() => OpenApproveConfirm("PQLN", "Xác nhận duyệt hồ sơ (PQLN)", "Sau khi duyệt, hồ sơ sẽ được chuyển sang Phòng Dịch vụ (PDV).")'>
                                        ✓ Duyệt PQLN
                                    </button>
                                }
                                @if (CanReceivePdv) { <button class="btn btn-sm btn-primary fw-semibold px-3" disabled="@isSubmitting" @onclick="ReceivePdv">Tiếp nhận PDV</button> }
                                @if (CanPostEntry) { <button class="btn btn-sm btn-warning fw-semibold px-3" disabled="@isSubmitting" @onclick="PostEntry">Đi bút toán</button> }
                                @if (CanApprovePdv)
                                {
                                    var unsupCount = selected.DebtItems.Count(x => !IsItemFullyCompleted(x));
                                    var isFinalPdvApproveBlocked = St == "PdvEntryApproved" && unsupCount > 0;
                                    var pdvBtnText = St == "PdvEntryPosted"
                                        ? (unsupCount > 0 ? "✓ Duyệt bút toán (Lần 1)" : "✓ Duyệt hoàn tất")
                                        : "✓ Duyệt hoàn tất (Lần 2)";
                                    var pdvModalTitle = St == "PdvEntryPosted" && unsupCount > 0
                                        ? "Xác nhận duyệt bút toán — Lần 1 (PDV)"
                                        : "Xác nhận duyệt hoàn tất hồ sơ (PDV)";
                                    var pdvModalDesc = St == "PdvEntryPosted" && unsupCount > 0
                                        ? $"Hồ sơ sẽ chuyển sang trạng thái Chờ bổ sung chứng từ (còn {unsupCount} chứng từ chưa hoàn tất bổ sung/xác nhận)."
                                        : "Hồ sơ sẽ chuyển sang trạng thái HOÀN TẤT và kết thúc luồng xử lý.";

                                    <button class="btn btn-sm btn-success fw-semibold px-3"
                                            disabled="@(isSubmitting || isFinalPdvApproveBlocked)"
                                            title="@(isFinalPdvApproveBlocked ? $"Còn {unsupCount} chứng từ nợ chưa hoàn tất bổ sung/xác nhận, chưa thể duyệt hoàn tất" : pdvBtnText)"
                                            @onclick='() => OpenApproveConfirm("PDV", pdvModalTitle, pdvModalDesc)'>
                                        @pdvBtnText
                                    </button>
                                }
                            </div>
                        </div>
                    }

                    @if (actionMessage != null)
                    {
                        <div class="alert alert-info py-1 mb-3 small">@actionMessage</div>
                    }

                    @* 3. Danh sách chứng từ nợ chia 2 cột song song PKH | PQLN *@
                    <div class="row g-3 mb-3">
                        @* Cột trái: Chứng từ nợ PKH *@
                        <div class="col-md-6">
                            <div class="border rounded h-100 p-2 bg-white">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                                    <span class="fw-bold text-primary small">CHỨNG TỪ NỢ PKH</span>
                                    <span class="badge bg-secondary-subtle text-dark">
                                        @pkhItems.Count(x => x.IsSupplemented && x.IsVerifiedByPqln)/@pkhItems.Count đã XN
                                    </span>
                                </div>

                                @if (pkhItems.Count == 0)
                                {
                                    <div class="text-muted small py-2 text-center">Không có chứng từ nợ PKH</div>
                                }
                                @foreach (var it in pkhItems)
                                {
                                    <div class="d-flex justify-content-between align-items-start border rounded px-2 py-1 mb-1 bg-light gap-2">
                                        @if (editingItemId == it.Id)
                                        {
                                            <input class="form-control form-control-sm" @bind="editItemName" placeholder="Tên chứng từ nợ" />
                                            <div class="d-flex gap-1 flex-shrink-0">
                                                <button class="btn btn-sm btn-success py-0 px-2" @onclick="() => SaveEditItem(it)">Lưu</button>
                                                <button class="btn btn-sm btn-secondary py-0 px-2" @onclick="CancelEditItem">Hủy</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <div class="small fw-medium">@it.ItemName</div>
                                                @if (it.IsSupplemented)
                                                {
                                                    <div class="text-muted" style="font-size: 0.75rem;">
                                                        <span>PKH bổ sung: <b>@(it.SupplementedAt.HasValue ? FormatFullVnTime(it.SupplementedAt.Value) : "—")</b></span>
                                                        @if (it.IsVerifiedByPqln)
                                                        {
                                                            <span class="text-success ms-2">• PQLN xác nhận: <b>@(it.PqlnVerifiedAt.HasValue ? FormatFullVnTime(it.PqlnVerifiedAt.Value) : "—")</b></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-primary ms-2">• <i>Chờ PQLN xác nhận</i></span>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                                @if (!it.IsSupplemented)
                                                {
                                                    <span class="badge bg-warning text-dark">Chưa bổ sung</span>
                                                }
                                                else if (!it.IsVerifiedByPqln)
                                                {
                                                    <span class="badge bg-info text-dark">Chờ PQLN XN</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">✓ Đã xác nhận</span>
                                                }

                                                @if (CanManagePkhItem && !it.IsSupplemented)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => StartEditItem(it)">Sửa</button>
                                                    <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => DeleteDebtItem(it.Id)">Xóa</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (CanManagePkhItem)
                                {
                                    <div class="input-group input-group-sm mt-2">
                                        <input class="form-control" @bind="addItemName" placeholder="Thêm chứng từ nợ PKH..." />
                                        <button class="btn btn-outline-primary" @onclick="AddDebtItem">+ Thêm</button>
                                    </div>
                                }
                            </div>
                        </div>

                        @* Cột phải: Chứng từ nợ PQLN *@
                        <div class="col-md-6">
                            <div class="border rounded h-100 p-2 bg-white">
                                <div class="d-flex justify-content-between align-items-center border-bottom pb-1 mb-2">
                                    <span class="fw-bold text-info-emphasis small">CHỨNG TỪ NỢ PQLN</span>
                                    <span class="badge bg-secondary-subtle text-dark">
                                        @pqlnItems.Count(x => x.IsSupplemented && x.IsVerifiedByPdv)/@pqlnItems.Count đã XN
                                    </span>
                                </div>

                                @if (pqlnItems.Count == 0)
                                {
                                    <div class="text-muted small py-2 text-center">Không có chứng từ nợ PQLN</div>
                                }
                                @foreach (var it in pqlnItems)
                                {
                                    <div class="d-flex justify-content-between align-items-start border rounded px-2 py-1 mb-1 bg-light gap-2">
                                        @if (editingItemId == it.Id)
                                        {
                                            <input class="form-control form-control-sm" @bind="editItemName" placeholder="Tên chứng từ nợ" />
                                            <div class="d-flex gap-1 flex-shrink-0">
                                                <button class="btn btn-sm btn-success py-0 px-2" @onclick="() => SaveEditItem(it)">Lưu</button>
                                                <button class="btn btn-sm btn-secondary py-0 px-2" @onclick="CancelEditItem">Hủy</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <div class="small fw-medium">@it.ItemName</div>
                                                @if (it.IsSupplemented)
                                                {
                                                    <div class="text-muted" style="font-size: 0.75rem;">
                                                        <span>PQLN bổ sung: <b>@(it.SupplementedAt.HasValue ? FormatFullVnTime(it.SupplementedAt.Value) : "—")</b></span>
                                                        @if (it.IsVerifiedByPdv)
                                                        {
                                                            <span class="text-success ms-2">• PDV xác nhận: <b>@(it.PdvVerifiedAt.HasValue ? FormatFullVnTime(it.PdvVerifiedAt.Value) : "—")</b></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-primary ms-2">• <i>Chờ PDV xác nhận</i></span>
                                                        }
                                                    </div>
                                                }
                                            </div>

                                            <div class="d-flex align-items-center gap-1 flex-shrink-0">
                                                @if (!it.IsSupplemented)
                                                {
                                                    <span class="badge bg-warning text-dark">Chưa bổ sung</span>
                                                }
                                                else if (!it.IsVerifiedByPdv)
                                                {
                                                    <span class="badge bg-info text-dark">Chờ PDV XN</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">✓ Đã xác nhận</span>
                                                }

                                                @if (CanManagePqlnItem && !it.IsSupplemented)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary py-0 px-2" @onclick="() => StartEditItem(it)">Sửa</button>
                                                    <button class="btn btn-sm btn-outline-danger py-0 px-2" @onclick="() => DeleteDebtItem(it.Id)">Xóa</button>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (CanManagePqlnItem)
                                {
                                    <div class="input-group input-group-sm mt-2">
                                        <input class="form-control" @bind="addItemName" placeholder="Thêm chứng từ nợ PQLN..." />
                                        <button class="btn btn-outline-primary" @onclick="AddDebtItem">+ Thêm</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    @* Bổ sung chứng từ (dành cho NV phụ trách PKH / PQLN) *@
                    @if (SupplementableItems.Any())
                    {
                        <div class="p-2 mb-3 border border-success rounded bg-success-subtle">
                            <div class="small fw-semibold text-success-emphasis mb-1">
                                Đánh dấu đã bổ sung chứng từ nợ (@Dept):
                            </div>
                            <div class="d-flex flex-wrap gap-3 mb-2">
                                @foreach (var it in SupplementableItems)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@suppIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleSupp(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label small">@it.ItemName</label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-success fw-semibold" @onclick="SupplementItems" disabled="@(suppIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận bổ sung @suppIds.Count chứng từ
                            </button>
                        </div>
                    }

                    @* Xác nhận đã nhận chứng từ bổ sung từ PKH (dành cho NV PQLN thụ lý) *@
                    @if (VerifiablePkhItems.Any())
                    {
                        <div class="p-2 mb-3 border border-info rounded bg-info-subtle">
                            <div class="small fw-semibold text-info-emphasis mb-1">
                                Xác nhận đã nhận chứng từ bổ sung từ PKH (PQLN):
                            </div>
                            <div class="d-flex flex-wrap gap-3 mb-2">
                                @foreach (var it in VerifiablePkhItems)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@verifyIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleVerify(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label small">
                                            @it.ItemName
                                            @if (it.SupplementedAt.HasValue)
                                            {
                                                <span class="text-muted">(PKH báo lúc @FormatFullVnTime(it.SupplementedAt.Value))</span>
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-primary fw-semibold" @onclick="VerifyPkhItems" disabled="@(verifyIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận đã nhận @verifyIds.Count chứng từ từ PKH
                            </button>
                        </div>
                    }

                    @* Xác nhận đã nhận chứng từ bổ sung từ PQLN (dành cho NV PDV thụ lý) *@
                    @if (VerifiablePqlnItems.Any())
                    {
                        <div class="p-2 mb-3 border border-primary rounded bg-primary-subtle">
                            <div class="small fw-semibold text-primary-emphasis mb-1">
                                Xác nhận đã nhận chứng từ bổ sung từ PQLN (PDV):
                            </div>
                            <div class="d-flex flex-wrap gap-3 mb-2">
                                @foreach (var it in VerifiablePqlnItems)
                                {
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@verifyPqlnIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleVerifyPqln(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label small">
                                            @it.ItemName
                                            @if (it.SupplementedAt.HasValue)
                                            {
                                                <span class="text-muted">(PQLN báo lúc @FormatFullVnTime(it.SupplementedAt.Value))</span>
                                            }
                                        </label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-primary fw-semibold" @onclick="VerifyPqlnItems" disabled="@(verifyPqlnIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận đã nhận @verifyPqlnIds.Count chứng từ từ PQLN
                            </button>
                        </div>
                    }

                    @* 4. Luồng theo dõi *@
                    <div class="fw-bold small text-muted mb-1">LUỒNG THEO DÕI LỊCH SỬ</div>
                    <div class="border rounded p-2 bg-light" style="max-height: 220px; overflow-y: auto;">
                        @foreach (var h in selected.CirculationHistory)
                        {
                            <div class="small border-bottom py-1">
                                <div class="d-flex flex-wrap justify-content-between">
                                    <span>
                                        <span class="badge bg-secondary-subtle text-dark me-1">@h.Action</span>
                                        <b>@h.PerformedByUserName</b>
                                        @if (!string.IsNullOrEmpty(h.FromDepartmentName) || !string.IsNullOrEmpty(h.ToDepartmentName))
                                        {
                                            <span class="text-muted"> (@(h.FromDepartmentName ?? "Khởi tạo") → @h.ToDepartmentName)</span>
                                        }
                                    </span>
                                    <span class="text-muted">@FormatFullVnTime(h.CreatedAt)</span>
                                </div>
                                <div class="text-body mt-1">@h.Notes</div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* === Popup xác nhận duyệt của SUP === *@
        @if (selected != null && pendingApproveAction != null)
        {
            var unsupCount = selected.DebtItems.Count(x => !IsItemFullyCompleted(x));
            <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0, 0, 0, 0.5);">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content border-0 shadow">
                        <div class="modal-header bg-success text-white py-2">
                            <h6 class="modal-title fw-bold mb-0">@confirmApproveTitle</h6>
                            <button type="button" class="btn-close btn-close-white" disabled="@isSubmitting" @onclick="CloseApproveConfirm"></button>
                        </div>
                        <div class="modal-body">
                            <p class="mb-2">@confirmApproveMessage</p>
                            <div class="p-2 rounded bg-light border small mb-2">
                                <div><b>Số văn bản:</b> @selected.DocumentNumber</div>
                                <div><b>Khách hàng:</b> @selected.CustomerName</div>
                                <div><b>Ghi chú duyệt:</b> @(string.IsNullOrWhiteSpace(approvalNote) ? "(Mặc định)" : approvalNote.Trim())</div>
                            </div>
                            @if (unsupCount > 0)
                            {
                                <div class="alert alert-warning py-1 px-2 small mb-0">
                                    Lưu ý: Hồ sơ hiện còn <b>@unsupCount</b> chứng từ nợ chưa hoàn tất bổ sung / xác nhận.
                                </div>
                            }
                        </div>
                        <div class="modal-footer py-2">
                            <button type="button" class="btn btn-sm btn-secondary" disabled="@isSubmitting" @onclick="CloseApproveConfirm">Hủy</button>
                            <button type="button" class="btn btn-sm btn-success fw-semibold px-3" disabled="@isSubmitting" @onclick="ConfirmApproveAsync">
                                @(isSubmitting ? "Đang xử lý..." : "✓ Xác nhận duyệt")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* === Danh sách hồ sơ === *@
        <div class="card shadow-sm">
            <div class="card-header bg-white py-2">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
                    <div class="d-flex align-items-center gap-2">
                        <b class="fs-6">Danh sách hồ sơ (@filtered.Count)</b>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <input class="form-control form-control-sm" style="width:230px"
                               @bind="searchText" @bind:event="oninput"
                               placeholder="Tìm số VB, khách hàng, cán bộ..." />

                        <select class="form-select form-select-sm" style="width:130px" @bind="filterDept">
                            <option value="">Tất cả phòng</option>
                            <option value="PKH">PKH</option>
                            <option value="PQLN">PQLN</option>
                            <option value="PDV">PDV</option>
                        </select>

                        <select class="form-select form-select-sm" style="width:160px" @bind="filterStatus">
                            <option value="">Mọi trạng thái</option>
                            <option value="pending">Chờ duyệt / nhận</option>
                            <option value="processing">Đang thụ lý</option>
                            <option value="supplement">Chờ bổ sung CT</option>
                            <option value="completed">Hoàn tất</option>
                        </select>

                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadAsync">Làm mới</button>
                    </div>
                </div>

                @* Tab lọc nhanh theo công việc *@
                <ul class="nav nav-pills nav-fill small gap-1" style="max-width: 680px;">
                    <li class="nav-item">
                        <button class="nav-link py-1 px-2 @(quickTab == "mine" ? "active" : "bg-light text-dark")"
                                @onclick='() => quickTab = "mine"'>
                            Cần tôi xử lý <span class="badge @(quickTab == "mine" ? "bg-white text-primary" : "bg-danger") ms-1">@MyActionCount</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-1 px-2 @(quickTab == "active" ? "active" : "bg-light text-dark")"
                                @onclick='() => quickTab = "active"'>
                            Đang xử lý <span class="badge bg-secondary ms-1">@docs.Count(d => d.Status != "Completed")</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-1 px-2 @(quickTab == "completed" ? "active" : "bg-light text-dark")"
                                @onclick='() => quickTab = "completed"'>
                            Hoàn tất <span class="badge bg-secondary ms-1">@docs.Count(d => d.Status == "Completed")</span>
                        </button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link py-1 px-2 @(quickTab == "all" ? "active" : "bg-light text-dark")"
                                @onclick='() => quickTab = "all"'>
                            Tất cả <span class="badge bg-secondary ms-1">@docs.Count</span>
                        </button>
                    </li>
                </ul>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle table-sm mb-0">
                    <thead class="table-light text-muted small">
                        <tr>
                            <th class="ps-3">HỒ SƠ / KHÁCH HÀNG</th>
                            <th>NGƯỜI PHỤ TRÁCH</th>
                            <th>PHÒNG & TRẠNG THÁI</th>
                            <th>CHỨNG TỪ NỢ</th>
                            <th>THỜI GIAN</th>
                            <th class="text-end pe-3">THAO TÁC</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (filtered.Count == 0)
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">Không có hồ sơ nào phù hợp điều kiện lọc.</td>
                            </tr>
                        }
                        @foreach (var d in filtered)
                        {
                            var isMyTurn = IsActionRequiredForMe(d);
                            var isOverdue = IsOverdue(d);
                            <tr class="@(isMyTurn ? "table-warning bg-opacity-25" : "")">
                                @* 1. Số VB + Khách hàng *@
                                <td class="ps-3 py-2">
                                    <div class="d-flex align-items-center gap-1">
                                        <b class="text-dark">@d.DocumentNumber</b>
                                        @if (d.Priority is "high" or "urgent")
                                        {
                                            <span class="badge bg-danger" style="font-size: 0.68rem;">Khẩn</span>
                                        }
                                    </div>
                                    <div class="small text-muted">
                                        <span class="fw-semibold text-body">@d.CustomerName</span>
                                        @if (!string.IsNullOrWhiteSpace(d.CustomerPhone))
                                        {
                                            <span> · @d.CustomerPhone</span>
                                        }
                                    </div>
                                </td>

                                @* 2. Người phụ trách (Hồ sơ của ai) *@
                                <td class="py-2">
                                    <div class="small fw-semibold">
                                        @CurrentHandlerText(d)
                                    </div>
                                    <div class="text-muted" style="font-size: 0.78rem;">
                                        Tạo PKH: @(d.CreatedByUserName ?? "—")
                                    </div>
                                </td>

                                @* 3. Phòng + Trạng thái *@
                                <td class="py-2">
                                    <div class="d-flex flex-wrap align-items-center gap-1">
                                        <span class="badge @DeptBadgeClass(d.CurrentDepartmentCode)">@d.CurrentDepartmentCode</span>
                                        <span class="badge @StatusBadgeClass(d.Status)">@StatusLabel(d.Status)</span>
                                    </div>
                                </td>

                                @* 4. Tiến độ chứng từ nợ *@
                                <td class="py-2">
                                    @if (d.TotalDebtItems == 0)
                                    {
                                        <span class="text-muted small">Không có</span>
                                    }
                                    else if (d.SupplementedDebtItems >= d.TotalDebtItems)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle">
                                            ✓ @d.SupplementedDebtItems/@d.TotalDebtItems đủ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-dark border border-warning">
                                            @d.SupplementedDebtItems/@d.TotalDebtItems đã BS
                                        </span>
                                    }
                                </td>

                                @* 5. Mốc thời gian *@
                                <td class="py-2 small">
                                    <div class="text-muted" title="Thời điểm cập nhật gần nhất">
                                        CN: @FormatVnTime(d.UpdatedAt)
                                    </div>
                                    <div class="@(isOverdue ? "text-danger fw-bold" : "text-muted")">
                                        Hạn: @FormatDate(d.DueDate) @(isOverdue ? "(Quá hạn)" : "")
                                    </div>
                                </td>

                                @* 6. Nút thao tác *@
                                <td class="text-end pe-3 py-2">
                                    <button class="btn btn-sm @(isMyTurn ? "btn-primary" : "btn-outline-primary")"
                                            @onclick="() => ViewAsync(d.Id)">
                                        @(isMyTurn ? "Xử lý" : "Xem")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

@code {
    string email = "", password = "";
    string? loginError;
    string? createError;
    string? actionMessage;
    string? actionError;
    bool isSubmitting;
    string? pendingApproveAction;
    string confirmApproveTitle = "";
    string confirmApproveMessage = "";

    List<DebtDocumentDto> docs = new();
    DebtDocumentDetailDto? selected;
    List<AppUserDto> allUsers = new();
    bool showUsers;
    string searchText = "";
    string filterStatus = "";
    string filterDept = "";
    string quickTab = "mine";

    string newName = "",
           newPhone = "",
           newIssue = DateTime.UtcNow.AddHours(7).ToString("yyyy-MM-dd"),
           newDue = DateTime.UtcNow.AddHours(7).AddDays(30).ToString("yyyy-MM-dd");
    bool newHasDebt;
    List<CreateDebtItemRequest> newItems = new();
    string addItemName = "";
    string approvalNote = "";
    HashSet<Guid> suppIds = new();
    HashSet<Guid> verifyIds = new();
    HashSet<Guid> verifyPqlnIds = new();
    Guid? editingItemId;
    string editItemName = "";

    string Dept => Session.CurrentUser?.DepartmentCode ?? "";
    string St => selected?.Status ?? "";
    bool R(string r) => Session.CurrentUser?.Role == r;

    static bool IsItemFullyCompleted(DebtItemDto x)
    {
        if (!x.IsSupplemented) return false;
        var deptCode = x.SourceDepartmentCode ?? "PKH";
        return deptCode switch
        {
            "PKH" => x.IsVerifiedByPqln,
            "PQLN" => x.IsVerifiedByPdv,
            _ => true
        };
    }

    bool CanApprovePkh => selected != null && Dept == "PKH" && R("manager") && St == "PkhPendingSup";
    bool CanReceivePqln => selected != null && Dept == "PQLN" && R("staff") && St == "PqlnPendingReceive";
    bool CanSubmitPqln => selected != null && Dept == "PQLN" && R("staff") && St == "PqlnReceived" && selected.PqlnReceiverId == Session.CurrentUser?.Id;
    bool CanApprovePqln => selected != null && Dept == "PQLN" && R("manager") && St == "PqlnPendingSup";
    bool CanReceivePdv => selected != null && Dept == "PDV" && R("staff") && St == "PdvPendingReceive";
    bool CanPostEntry => selected != null && Dept == "PDV" && R("staff") && St == "PdvReceived" && selected.PdvReceiverId == Session.CurrentUser?.Id;
    bool CanApprovePdv => selected != null && Dept == "PDV" && R("manager") && (St == "PdvEntryPosted" || St == "PdvEntryApproved");

    bool CanSupplement => selected != null
        && Session.CurrentUser != null
        && R("staff")
        && ((Dept == "PKH" && selected.CreatedByUserId == Session.CurrentUser.Id)
            || (Dept == "PQLN" && selected.PqlnReceiverId == Session.CurrentUser.Id));

    IEnumerable<DebtItemDto> SupplementableItems => selected == null || !CanSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => !x.IsSupplemented && (x.SourceDepartmentCode ?? "PKH") == Dept);

    bool CanVerifyPkhSupplement => selected != null
        && Session.CurrentUser != null
        && R("staff")
        && Dept == "PQLN"
        && selected.PqlnReceiverId == Session.CurrentUser.Id;

    IEnumerable<DebtItemDto> VerifiablePkhItems => selected == null || !CanVerifyPkhSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => (x.SourceDepartmentCode ?? "PKH") == "PKH"
                                     && x.IsSupplemented
                                     && !x.IsVerifiedByPqln);

    bool CanVerifyPqlnSupplement => selected != null
        && Session.CurrentUser != null
        && R("staff")
        && Dept == "PDV"
        && selected.PdvReceiverId == Session.CurrentUser.Id;

    IEnumerable<DebtItemDto> VerifiablePqlnItems => selected == null || !CanVerifyPqlnSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => x.SourceDepartmentCode == "PQLN"
                                     && x.IsSupplemented
                                     && !x.IsVerifiedByPdv);

    // Quyền Thêm / Sửa / Xóa chứng từ nợ
    bool CanManagePkhItem => selected != null && Dept == "PKH" && R("staff") && St == "PkhPendingSup" && selected.CreatedByUserId == Session.CurrentUser?.Id;
    bool CanManagePqlnItem => selected != null && Dept == "PQLN" && R("staff") && (St == "PqlnReceived" || St == "PqlnPendingSup") && selected.PqlnReceiverId == Session.CurrentUser?.Id;
    bool CanAddDebtItem => CanManagePkhItem || CanManagePqlnItem;

    int MyActionCount => docs.Count(IsActionRequiredForMe);

    bool IsActionRequiredForMe(DebtDocumentDto d)
    {
        var u = Session.CurrentUser;
        if (u == null || d.Status == "Completed") return false;

        if (u.Role == "manager")
        {
            return (u.DepartmentCode == "PKH" && d.Status == "PkhPendingSup")
                || (u.DepartmentCode == "PQLN" && d.Status == "PqlnPendingSup")
                || (u.DepartmentCode == "PDV" && d.Status is "PdvEntryPosted" or "PdvEntryApproved");
        }

        if (u.Role == "staff")
        {
            if (u.DepartmentCode == "PKH")
                return d.CreatedByUserId == u.Id && d.TotalDebtItems > d.SupplementedDebtItems;

            if (u.DepartmentCode == "PQLN")
                return (d.Status == "PqlnPendingReceive")
                    || (d.PqlnReceiverId == u.Id && (d.Status == "PqlnReceived" || d.TotalDebtItems > d.SupplementedDebtItems));

            if (u.DepartmentCode == "PDV")
                return (d.Status == "PdvPendingReceive")
                    || (d.PdvReceiverId == u.Id && (d.Status == "PdvReceived" || d.TotalDebtItems > d.SupplementedDebtItems));
        }

        return false;
    }

    List<DebtDocumentDto> filtered => docs
        .Where(d =>
        {
            if (quickTab == "mine" && !IsActionRequiredForMe(d)) return false;
            if (quickTab == "active" && d.Status == "Completed") return false;
            if (quickTab == "completed" && d.Status != "Completed") return false;

            if (!string.IsNullOrEmpty(filterDept) && d.CurrentDepartmentCode != filterDept) return false;

            if (filterStatus == "pending" && d.Status is not ("PkhPendingSup" or "PqlnPendingReceive" or "PqlnPendingSup" or "PdvPendingReceive")) return false;
            if (filterStatus == "processing" && d.Status is not ("PqlnReceived" or "PdvReceived" or "PdvEntryPosted")) return false;
            if (filterStatus == "supplement" && !(d.TotalDebtItems > d.SupplementedDebtItems)) return false;
            if (filterStatus == "completed" && d.Status != "Completed") return false;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var q = searchText.Trim().ToLower();
                var match = d.DocumentNumber.ToLower().Contains(q)
                         || d.CustomerName.ToLower().Contains(q)
                         || (d.CreatedByUserName?.ToLower().Contains(q) ?? false)
                         || (d.PqlnReceiverName?.ToLower().Contains(q) ?? false)
                         || (d.PdvReceiverName?.ToLower().Contains(q) ?? false);
                if (!match) return false;
            }

            return true;
        })
        .OrderByDescending(IsActionRequiredForMe)
        .ThenByDescending(d => d.UpdatedAt)
        .ToList();

    string CurrentHandlerText(DebtDocumentDto d) => d.Status switch
    {
        "PkhPendingSup" => $"Chờ SUP PKH ({d.CreatedByUserName})",
        "PqlnPendingReceive" => "PQLN: Chờ tiếp nhận",
        "PqlnReceived" or "PqlnPendingSup" => $"PQLN: {d.PqlnReceiverName ?? "—"}",
        "PdvPendingReceive" => "PDV: Chờ tiếp nhận",
        "PdvReceived" or "PdvEntryPosted" or "PdvEntryApproved" => $"PDV: {d.PdvReceiverName ?? "—"}",
        "Completed" => $"Hoàn tất ({d.PdvReceiverName ?? d.CreatedByUserName})",
        _ => d.CreatedByUserName ?? "—"
    };

    string DeptBadgeClass(string? code) => code switch
    {
        "PKH" => "bg-primary-subtle text-primary border border-primary-subtle",
        "PQLN" => "bg-info-subtle text-info-emphasis border border-info-subtle",
        "PDV" => "bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle",
        _ => "bg-secondary"
    };

    string StatusBadgeClass(string s) => s switch
    {
        "PkhPendingSup" or "PqlnPendingReceive" or "PqlnPendingSup" or "PdvPendingReceive" => "bg-warning text-dark",
        "PqlnReceived" or "PdvReceived" or "PdvEntryPosted" => "bg-primary",
        "PdvEntryApproved" => "bg-info text-dark",
        "Completed" => "bg-success",
        _ => "bg-secondary"
    };

    string StatusLabel(string s) => s switch
    {
        "PkhPendingSup" => "Chờ SUP PKH",
        "PqlnPendingReceive" => "Chờ PQLN nhận",
        "PqlnReceived" => "PQLN đang xử lý",
        "PqlnPendingSup" => "Chờ SUP PQLN",
        "PdvPendingReceive" => "Chờ PDV nhận",
        "PdvReceived" => "PDV đang xử lý",
        "PdvEntryPosted" => "Chờ SUP PDV duyệt",
        "PdvEntryApproved" => "Chờ bổ sung CT",
        "Completed" => "HOÀN TẤT",
        _ => s
    };

    DateTime ToVnTime(DateTime dt) =>
        dt.Kind == DateTimeKind.Local
            ? dt.ToUniversalTime().AddHours(7)
            : dt.AddHours(7);

    string FormatVnTime(DateTime dt) => ToVnTime(dt).ToString("dd/MM HH:mm");

    string FormatFullVnTime(DateTime dt) => ToVnTime(dt).ToString("dd/MM/yyyy HH:mm:ss");

    string FormatDate(string yyyyMmDd)
        => DateOnly.TryParse(yyyyMmDd, out var date) ? date.ToString("dd/MM/yyyy") : yyyyMmDd;

    bool IsOverdue(DebtDocumentDto d)
        => d.Status != "Completed"
        && DateOnly.TryParse(d.DueDate, out var due)
        && due < DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));

    protected override async Task OnInitializedAsync() { await Session.InitializeAsync(); if (Session.IsAuthenticated) await LoadAsync(); }
    async Task LoginAsync() { loginError = await Session.LoginAsync(email, password); if (loginError == null) await LoadAsync(); }
    async Task Logout() { await Session.LogoutAsync(); docs.Clear(); selected = null; }

    async Task LoadAsync()
    {
        if (Session.CurrentUser != null)
        {
            if (Session.CurrentUser.Role == "admin") quickTab = "all";
            docs = (await DocService.GetAllAsync(null, null, null, Session.CurrentUser.Id)).ToList();
        }
    }

    async Task ViewAsync(Guid id)
    {
        suppIds.Clear();
        verifyIds.Clear();
        verifyPqlnIds.Clear();
        pendingApproveAction = null;
        approvalNote = "";
        CancelEditItem();
        actionMessage = null;
        actionError = null;
        if (Session.CurrentUser != null)
            selected = await DocService.GetByIdAsync(id, Session.CurrentUser.Id);
    }

    void Close()
    {
        CancelEditItem();
        approvalNote = "";
        pendingApproveAction = null;
        suppIds.Clear();
        verifyIds.Clear();
        verifyPqlnIds.Clear();
        selected = null;
    }

    async Task ToggleUsers() { showUsers = !showUsers; if (showUsers) allUsers = (await UserService.GetAllAsync()).ToList(); }

    void OpenApproveConfirm(string actionKey, string title, string message)
    {
        if (selected == null || isSubmitting) return;
        pendingApproveAction = actionKey;
        confirmApproveTitle = title;
        confirmApproveMessage = message;
    }

    void CloseApproveConfirm()
    {
        if (isSubmitting) return;
        pendingApproveAction = null;
        confirmApproveTitle = "";
        confirmApproveMessage = "";
    }

    async Task ConfirmApproveAsync()
    {
        var action = pendingApproveAction;
        pendingApproveAction = null;
        if (selected == null || string.IsNullOrEmpty(action)) return;

        switch (action)
        {
            case "PKH":
                await ApprovePkh();
                break;
            case "PQLN":
                await ApprovePqln();
                break;
            case "PDV":
                await ApprovePdv();
                break;
        }
    }

    async Task CreateDoc()
    {
        if (string.IsNullOrWhiteSpace(newName)) { createError = "Nhập tên KH"; return; }
        try
        {
            var nowVn = DateTime.UtcNow.AddHours(7);
            await DocService.CreateAsync(new CreateDebtDocumentRequest { CustomerName = newName, CustomerPhone = newPhone, CustomerType = "company", IssueDate = newIssue, DueDate = newDue, Priority = "normal", HasDebtDocuments = newHasDebt, DebtItems = newItems }, Session.CurrentUser!.Id);
            newName = "";
            newPhone = "";
            newIssue = nowVn.ToString("yyyy-MM-dd");
            newDue = nowVn.AddDays(30).ToString("yyyy-MM-dd");
            newItems.Clear();
            newHasDebt = false;
            createError = null;
            await LoadAsync();
        }
        catch (Exception e) { createError = e.Message; }
    }

    async Task AddDebtItem()
    {
        if (selected == null || Session.CurrentUser == null || string.IsNullOrWhiteSpace(addItemName)) return;
        actionError = null;
        try
        {
            await DocService.AddDebtItemsAsync(
                selected.Id,
                new AddDebtItemsRequest(new List<CreateDebtItemRequest> { new CreateDebtItemRequest { ItemName = addItemName.Trim() } }, $"Thêm chứng từ nợ tại {Dept}"),
                Session.CurrentUser.Id);
            addItemName = "";
            await ViewAsync(selected.Id);
            await LoadAsync();
            actionMessage = "Đã thêm chứng từ nợ";
        }
        catch (Exception e) { actionError = e.Message; }
    }

    void StartEditItem(DebtItemDto it)
    {
        editingItemId = it.Id;
        editItemName = it.ItemName;
    }

    void CancelEditItem()
    {
        editingItemId = null;
        editItemName = "";
    }

    async Task SaveEditItem(DebtItemDto it)
    {
        if (selected == null || Session.CurrentUser == null) return;
        if (string.IsNullOrWhiteSpace(editItemName)) { actionError = "Tên chứng từ không được để trống"; return; }
        actionError = null;
        try
        {
            await DocService.UpdateDebtItemAsync(selected.Id, it.Id, new UpdateDebtItemRequest(editItemName.Trim(), it.Notes), Session.CurrentUser.Id);
            CancelEditItem();
            await ViewAsync(selected.Id);
            actionMessage = "Đã cập nhật tên chứng từ nợ";
        }
        catch (Exception e) { actionError = e.Message; }
    }

    async Task DeleteDebtItem(Guid itemId)
    {
        if (selected == null || Session.CurrentUser == null) return;
        actionError = null;
        try
        {
            await DocService.DeleteDebtItemAsync(selected.Id, itemId, Session.CurrentUser.Id);
            suppIds.Remove(itemId);
            await ViewAsync(selected.Id);
            await LoadAsync();
            actionMessage = "Đã xóa chứng từ nợ";
        }
        catch (Exception e) { actionError = e.Message; }
    }

    void ToggleSupp(Guid id, bool check) { if (check) suppIds.Add(id); else suppIds.Remove(id); }

