@page "/"
@inject BlazorSession Session
@inject IDebtDocumentService DocService
@inject IUserService UserService

<PageTitle>VCB Debt Management — Quản lý hồ sơ văn bản nợ</PageTitle>

@if (!Session.IsInitialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 70vh;">
        <span class="spinner-border text-success"></span>
    </div>
}
else if (!Session.IsAuthenticated)
{
    @* ================= MÀN HÌNH ĐĂNG NHẬP SPLIT-CARD ================= *@
    <div class="vcb-login-wrapper">
        <div class="vcb-login-card">
            @* Cột trái: Thương hiệu & chỉ số *@
            <div class="vcb-login-left">
                <div>
                    <div class="vcb-login-pill mb-5">VCB</div>
                    <h2 class="fw-bold mb-3" style="font-size: 28px; line-height: 1.28; letter-spacing: -0.4px;">
                        Theo dõi chứng từ nợ,<br />minh bạch từng bước.
                    </h2>
                    <p class="mb-0" style="font-size: 14px; color: rgba(255,255,255,0.82); line-height: 1.6;">
                        Từ phòng Khách hàng đến phòng Quản lý nợ — mọi hồ sơ, chứng từ và lượt duyệt đều ở một nơi.
                    </p>
                </div>

                <div class="d-flex gap-3 mt-4">
                    <div class="vcb-stat-mini">
                        <div class="fw-bold fs-5">7</div>
                        <div style="font-size: 12px; color: rgba(255,255,255,0.75);">Bước duyệt</div>
                    </div>
                    <div class="vcb-stat-mini">
                        <div class="fw-bold fs-5">3</div>
                        <div style="font-size: 12px; color: rgba(255,255,255,0.75);">Phòng ban</div>
                    </div>
                    <div class="vcb-stat-mini">
                        <div class="fw-bold fs-5">24/7</div>
                        <div style="font-size: 12px; color: rgba(255,255,255,0.75);">Theo dõi</div>
                    </div>
                </div>
            </div>

            @* Cột phải: Form đăng nhập *@
            <div class="vcb-login-right">
                <h4 class="fw-bold mb-1" style="font-size: 22px;">Đăng nhập VCB</h4>
                <p class="text-muted small mb-4">Dùng tài khoản email Vietcombank của bạn.</p>

                <div class="mb-3">
                    <label class="form-label small fw-semibold mb-1">Email</label>
                    <div class="vcb-input-wrap">
                        <span class="vcb-input-icon">✉</span>
                        <input class="vcb-input" @bind="email" placeholder="ten@vietcombank.com.vn" />
                    </div>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-semibold mb-1">Mật khẩu</label>
                    <div class="vcb-input-wrap">
                        <span class="vcb-input-icon">🔒</span>
                        <input type="@(showPassword ? "text" : "password")"
                               class="vcb-input"
                               style="padding-right: 56px;"
                               @bind="password"
                               placeholder="••••••••" />
                        <button type="button"
                                class="btn btn-link btn-sm text-decoration-none text-muted position-absolute end-0 me-2"
                                style="font-size: 12px;"
                                @onclick="() => showPassword = !showPassword">
                            @(showPassword ? "Ẩn" : "Hiện")
                        </button>
                    </div>
                </div>

                @if (loginError != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">@loginError</div>
                }

                <button class="vcb-btn-primary w-100" @onclick="LoginAsync">
                    Đăng nhập →
                </button>
            </div>
        </div>
    </div>
}
else
{
    @* ================= TOPBAR HEADER CHUYÊN NGHIỆP ================= *@
    <div class="vcb-topbar">
        @* Trái: Breadcrumb & Ngày làm việc *@
        <div class="d-flex flex-column">
            <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 12px;">
                <span>VCB Debt Management</span>
                <span>/</span>
                <span class="text-success fw-semibold">@(showUsers ? "Quản trị người dùng" : "Hồ sơ văn bản nợ")</span>
            </div>
            <div class="fw-semibold text-dark mt-1" style="font-size: 13px;">
                📅 @DateTime.UtcNow.AddHours(7).ToString("dddd, dd/MM/yyyy", new System.Globalization.CultureInfo("vi-VN"))
            </div>
        </div>

        @* Phải: Hành động nhanh + Nhắc việc + User Profile Chip + Đăng xuất *@
        <div class="d-flex flex-wrap align-items-center gap-2">
            @if (Session.CurrentUser?.DepartmentCode == "PKH" && Session.CurrentUser?.Role == "staff")
            {
                <button class="vcb-btn-primary px-3" style="height: 36px; font-size: 13px;"
                        @onclick="() => showCreateModal = !showCreateModal">
                    + Tạo hồ sơ mới
                </button>
            }

            @if (Session.CurrentUser?.Role == "admin")
            {
                <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" style="height: 36px;" @onclick="ToggleUsers">
                    @(showUsers ? "← Danh sách hồ sơ" : "👥 Quản lý người dùng")
                </button>
            }

            @if (!showUsers && MyActionCount > 0)
            {
                <button type="button"
                        class="btn btn-sm rounded-pill px-3 fw-semibold"
                        style="height: 36px; background: #fff4e5; color: #b86600; border: 1px solid #ffd8a8; font-size: 12.5px;"
                        @onclick='() => { quickTab = "mine"; filterStatus = ""; }'>
                    🔔 @MyActionCount việc cần xử lý
                </button>
            }

            @* User Profile Chip (Avatar LA chuẩn tên Việt) *@
            <div class="vcb-user-chip">
                <div class="vcb-avatar">@GetInitials(Session.CurrentUser?.Name)</div>
                <div class="lh-sm pe-1">
                    <div class="fw-bold text-dark" style="font-size: 13px;">@Session.CurrentUser?.Name</div>
                    <div class="text-muted" style="font-size: 11px;">
                        <span class="fw-semibold text-success">@Session.CurrentUser?.DepartmentCode</span>
                        · @RoleLabel(Session.CurrentUser?.Role)
                    </div>
                </div>
            </div>

            <button type="button" class="vcb-logout-pill" title="Đăng xuất khỏi hệ thống" @onclick="Logout">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <polyline points="16 17 21 12 16 7" />
                    <line x1="21" y1="12" x2="9" y2="12" />
                </svg>
                <span>Đăng xuất</span>
            </button>
        </div>
    </div>

    @if (showUsers)
    {
        <div class="vcb-surface mb-4">
            <div class="p-3 border-bottom fw-bold">Quản lý người dùng hệ thống</div>
            <div class="table-responsive">
                <table class="table vcb-table mb-0">
                    <thead><tr><th>Tên</th><th>Email</th><th>Phòng</th><th>Vai trò</th><th>Trạng thái</th></tr></thead>
                    <tbody>
                        @foreach (var u in allUsers)
                        {
                            <tr>
                                <td class="fw-semibold">@u.Name</td>
                                <td class="text-muted">@u.Email</td>
                                <td><span class="vcb-dept-pill">@u.DepartmentName</span></td>
                                <td>@u.Role</td>
                                <td>@(u.IsActive ? "✅ Hoạt động" : "❌ Khóa")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        @* Tiêu đề trang gọn gàng ngay trên 4 thẻ KPI *@
        <div class="mb-3">
            <h4 class="fw-bold mb-1" style="letter-spacing: -0.3px;">Quản lý hồ sơ văn bản nợ</h4>
            <p class="text-muted small mb-0">Theo dõi tiến độ phê duyệt, tiếp nhận và bổ sung chứng từ nợ liên phòng ban.</p>
        </div>

        @* === Form tạo hồ sơ mới (mở gọn khi bấm + Tạo hồ sơ mới) === *@
        @if (showCreateModal && Session.CurrentUser?.DepartmentCode == "PKH" && Session.CurrentUser?.Role == "staff")
        {
            <div class="vcb-surface p-4 mb-4 border-success">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h6 class="fw-bold text-success mb-0">Khởi tạo hồ sơ văn bản nợ mới</h6>
                    <button class="btn btn-sm btn-light" @onclick="() => showCreateModal = false">✕</button>
                </div>
                @if (createError != null) { <div class="alert alert-danger py-2 small">@createError</div> }

                <div class="row g-3 mb-3">
                    @* Chọn loại khách hàng: Công ty / Cá nhân *@
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold mb-1">Đối tượng khách hàng <span class="text-danger">*</span></label>
                        <div class="d-flex gap-2">
                            <button type="button"
                                    class="btn btn-sm px-3 fw-semibold rounded-3 @(newCustomerType == "company" ? "btn-success" : "btn-outline-secondary")"
                                    @onclick='() => newCustomerType = "company"'>
                                🏢 Công ty
                            </button>
                            <button type="button"
                                    class="btn btn-sm px-3 fw-semibold rounded-3 @(newCustomerType == "individual" ? "btn-success" : "btn-outline-secondary")"
                                    @onclick='() => newCustomerType = "individual"'>
                                👤 Cá nhân
                            </button>
                        </div>
                    </div>

                    @* Chọn luồng xử lý hồ sơ *@
                    <div class="col-md-7">
                        <label class="form-label small fw-semibold mb-1">Luồng xử lý hồ sơ <span class="text-danger">*</span></label>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button"
                                    class="btn btn-sm px-3 fw-semibold rounded-3 @(newWorkflowType == "pkh_pqln_pdv" ? "btn-success" : "btn-outline-secondary")"
                                    @onclick='() => newWorkflowType = "pkh_pqln_pdv"'>
                                🔁 Tiêu chuẩn (PKH → PQLN → PDV)
                            </button>
                            <button type="button"
                                    class="btn btn-sm px-3 fw-semibold rounded-3 @(newWorkflowType == "pkh_pdv" ? "btn-primary" : "btn-outline-secondary")"
                                    @onclick='() => newWorkflowType = "pkh_pdv"'>
                                ⚡ Chuyển thẳng PDV (PKH → PDV)
                            </button>
                        </div>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">
                            @(newCustomerType == "company" ? "Tên công ty / doanh nghiệp" : "Họ và tên khách hàng") <span class="text-danger">*</span>
                        </label>
                        <input class="form-control" @bind="newName"
                               placeholder="@(newCustomerType == "company" ? "Nhập tên công ty..." : "Nhập họ và tên khách hàng...")" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Mã CIF</label>
                        <input class="form-control" @bind="newCif" placeholder="Nhập mã CIF..." />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Ngày phát sinh</label>
                        <input class="form-control" @bind="newIssue" disabled />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold mb-1">Hạn thanh toán</label>
                        <input class="form-control" @bind="newDue" placeholder="yyyy-MM-dd" />
                    </div>
                </div>

                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" @bind="newHasDebt" id="hd" />
                    <label class="form-check-label fw-semibold small" for="hd">Có chứng từ nợ kèm theo</label>
                </div>
                @if (newHasDebt)
                {
                    @foreach (var it in newItems)
                    {
                        <div class="input-group input-group-sm mb-2" style="max-width: 520px;">
                            <input class="form-control" @bind="it.ItemName" placeholder="Nhập tên chứng từ nợ..." />
                            <button class="btn btn-outline-danger" @onclick="() => newItems.Remove(it)">Xóa</button>
                        </div>
                    }
                    <button class="btn btn-sm btn-outline-success mb-2" @onclick="() => newItems.Add(new CreateDebtItemRequest())">+ Thêm chứng từ nợ</button>
                }
                <div class="mt-2 d-flex gap-2">
                    <button class="vcb-btn-primary px-4" style="height: 38px;" @onclick="CreateDoc">Lưu & Gửi SUP PKH</button>
                    <button class="btn btn-light border" @onclick="() => showCreateModal = false">Hủy</button>
                </div>
            </div>
        }

        @* ================= 4 THẺ KPI TƯƠNG TÁC (CLICK ĐỂ LỌC) ================= *@
        <div class="vcb-kpi-grid-compact">
            <button type="button"
                    class="vcb-kpi-btn @(quickTab == "all" && string.IsNullOrEmpty(filterStatus) ? "active" : "")"
                    @onclick='() => { quickTab = "all"; filterStatus = ""; }'>
                <div>
                    <div class="kpi-num">@docs.Count</div>
                    <div class="kpi-lbl">Tổng hồ sơ</div>
                </div>
                <div class="kpi-ico" style="background: #eaf5ee; color: #0a7a42;">📁</div>
            </button>

            <button type="button"
                    class="vcb-kpi-btn @(quickTab == "active" && string.IsNullOrEmpty(filterStatus) ? "active" : "")"
                    @onclick='() => { quickTab = "active"; filterStatus = ""; }'>
                <div>
                    <div class="kpi-num">@docs.Count(d => d.Status != "Completed")</div>
                    <div class="kpi-lbl">Đang xử lý</div>
                </div>
                <div class="kpi-ico" style="background: #eaf1fd; color: #1d63d0;">⏱</div>
            </button>

            <button type="button"
                    class="vcb-kpi-btn @(quickTab == "completed" ? "active" : "")"
                    @onclick='() => { quickTab = "completed"; filterStatus = ""; }'>
                <div>
                    <div class="kpi-num">@docs.Count(d => d.Status == "Completed")</div>
                    <div class="kpi-lbl">Hoàn tất</div>
                </div>
                <div class="kpi-ico" style="background: #e6f7ed; color: #0e8a4a;">✓</div>
            </button>

            <button type="button"
                    class="vcb-kpi-btn @(filterStatus == "supplement" ? "active" : "")"
                    @onclick='() => { quickTab = "all"; filterStatus = "supplement"; }'>
                <div>
                    <div class="kpi-num">@docs.Sum(d => Math.Max(0, d.TotalDebtItems - d.SupplementedDebtItems))</div>
                    <div class="kpi-lbl">Chứng từ còn thiếu</div>
                </div>
                <div class="kpi-ico" style="background: #fef5e4; color: #c77c08;">!</div>
            </button>
        </div>

        @* ================= THANH TÌM KIẾM & TAB LỌC ================= *@
        <div class="vcb-surface mb-3">
            <div class="p-3 px-4">
                <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
                    <div class="d-flex align-items-center gap-2">
                        <span class="fw-bold" style="font-size: 15.5px;">Danh sách hồ sơ</span>
                        <span class="badge rounded-pill bg-light text-dark border">@filtered.Count</span>
                    </div>

                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <div class="vcb-input-wrap" style="width: 245px;">
                            <span class="vcb-input-icon" style="font-size: 13px;">🔍</span>
                            <input class="vcb-input" style="height: 35px; font-size: 13px;"
                                   @bind="searchText" @bind:event="oninput"
                                   placeholder="Tìm số VB, CIF, khách hàng..." />
                        </div>

                        <select class="form-select form-select-sm rounded-3" style="width: 132px; height: 35px;" @bind="filterDept">
                            <option value="">Tất cả phòng</option>
                            <option value="PKH">PKH</option>
                            <option value="PQLN">PQLN</option>
                            <option value="PDV">PDV</option>
                        </select>

                        <select class="form-select form-select-sm rounded-3" style="width: 162px; height: 35px;" @bind="filterStatus">
                            <option value="">Mọi trạng thái</option>
                            <option value="pending">Chờ duyệt / nhận</option>
                            <option value="processing">Đang thụ lý</option>
                            <option value="supplement">Chờ bổ sung CT</option>
                            <option value="completed">Hoàn tất</option>
                        </select>

                        <button class="btn btn-sm bg-white border rounded-3 px-2" style="height: 35px;" title="Làm mới dữ liệu" @onclick="LoadAsync">
                            ↻
                        </button>
                    </div>
                </div>

                @* 4 Tab lọc nhanh theo công việc *@
                <div class="vcb-tabs">
                    <button type="button" class="vcb-tab-btn @(quickTab == "mine" ? "active" : "")"
                            @onclick='() => { quickTab = "mine"; filterStatus = ""; }'>
                        <span>Cần tôi xử lý</span>
                        @if (MyActionCount > 0)
                        {
                            <span class="badge rounded-pill bg-danger" style="font-size: 11px;">@MyActionCount</span>
                        }
                        else
                        {
                            <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">0</span>
                        }
                    </button>

                    <button type="button" class="vcb-tab-btn @(quickTab == "active" && string.IsNullOrEmpty(filterStatus) ? "active" : "")"
                            @onclick='() => { quickTab = "active"; filterStatus = ""; }'>
                        <span>Đang xử lý</span>
                        <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">@docs.Count(d => d.Status != "Completed")</span>
                    </button>

                    <button type="button" class="vcb-tab-btn @(quickTab == "completed" ? "active" : "")"
                            @onclick='() => { quickTab = "completed"; filterStatus = ""; }'>
                        <span>Hoàn tất</span>
                        <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">@docs.Count(d => d.Status == "Completed")</span>
                    </button>

                    <button type="button" class="vcb-tab-btn @(quickTab == "all" && string.IsNullOrEmpty(filterStatus) ? "active" : "")"
                            @onclick='() => { quickTab = "all"; filterStatus = ""; }'>
                        <span>Tất cả</span>
                        <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">@docs.Count</span>
                    </button>
                </div>
            </div>
        </div>

        @* ================= PHÂN TÁCH 2 PHẦN: CÔNG TY & CÁ NHÂN ================= *@
        @if (filtered.Count == 0)
        {
            <div class="vcb-surface p-5 text-center">
                @if (quickTab == "mine" && string.IsNullOrWhiteSpace(searchText) && string.IsNullOrEmpty(filterDept))
                {
                    <div class="fw-semibold text-success mb-1" style="font-size: 15px;">
                        🎉 Bạn đã hoàn thành tất cả hồ sơ cần xử lý!
                    </div>
                    <div class="text-muted small mb-3">Hiện không có hồ sơ hay chứng từ nào đang chờ thao tác của bạn.</div>
                    <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3"
                            @onclick='() => quickTab = "active"'>
                        Xem hồ sơ đang theo dõi (@docs.Count(d => d.Status != "Completed"))
                    </button>
                }
                else
                {
                    <span class="text-muted">Không có hồ sơ nào phù hợp điều kiện lọc hiện tại.</span>
                }
            </div>
        }
        else
        {
            var companyDocs = filtered.Where(d => d.CustomerType != "individual").ToList();
            var individualDocs = filtered.Where(d => d.CustomerType == "individual").ToList();

            @* PHẦN 1: KHÁCH HÀNG CÔNG TY *@
            <div class="vcb-surface mb-4">
                <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="background: #f8fbf9;">
                    <div class="d-flex align-items-center gap-2">
                        <span style="font-size: 16px;">🏢</span>
                        <span class="fw-bold text-dark" style="font-size: 14.5px;">Khách hàng Công ty</span>
                        <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">@companyDocs.Count</span>
                    </div>
                    @if (companyDocs.Any(IsActionRequiredForMe))
                    {
                        <span class="badge rounded-pill bg-danger-subtle text-danger" style="font-size: 11.5px;">
                            @companyDocs.Count(IsActionRequiredForMe) cần xử lý
                        </span>
                    }
                </div>

                @if (companyDocs.Count == 0)
                {
                    <div class="p-4 text-center text-muted small">Không có hồ sơ khách hàng Công ty trong mục này.</div>
                }
                else
                {
                    @RenderDocumentTable(companyDocs)
                }
            </div>

            @* PHẦN 2: KHÁCH HÀNG CÁ NHÂN *@
            <div class="vcb-surface">
                <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="background: #f8fafc;">
                    <div class="d-flex align-items-center gap-2">
                        <span style="font-size: 16px;">👤</span>
                        <span class="fw-bold text-dark" style="font-size: 14.5px;">Khách hàng Cá nhân</span>
                        <span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle">@individualDocs.Count</span>
                    </div>
                    @if (individualDocs.Any(IsActionRequiredForMe))
                    {
                        <span class="badge rounded-pill bg-danger-subtle text-danger" style="font-size: 11.5px;">
                            @individualDocs.Count(IsActionRequiredForMe) cần xử lý
                        </span>
                    }
                </div>

                @if (individualDocs.Count == 0)
                {
                    <div class="p-4 text-center text-muted small">Không có hồ sơ khách hàng Cá nhân trong mục này.</div>
                }
                else
                {
                    @RenderDocumentTable(individualDocs)
                }
            </div>
        }
    }
}

@* ================= SLIDE-OVER DRAWER CHI TIẾT HỒ SƠ ================= *@
@if (selected != null)
{
    var pkhItems = selected.DebtItems.Where(x => (x.SourceDepartmentCode ?? "PKH") == "PKH").ToList();
    var pqlnItems = selected.DebtItems.Where(x => x.SourceDepartmentCode == "PQLN").ToList();
    var completedItemsCount = selected.DebtItems.Count(x => IsItemFullyCompleted(x, IsDirectPdv));
    var totalPct = selected.DebtItems.Count == 0 ? 100 : (int)Math.Round(100.0 * completedItemsCount / selected.DebtItems.Count);
    var activeStepLabels = GetStepLabels(IsDirectPdv);
    var stepIdx = CurrentStepIndex(selected.Status, IsDirectPdv);

    <div class="vcb-backdrop" @onclick="Close">
        <div class="vcb-drawer" @onclick:stopPropagation="true">
            @* 1. Drawer Header Gradient *@
            <div class="vcb-drawer-header">
                <button class="vcb-drawer-close" @onclick="Close">✕</button>
                <div class="d-flex align-items-center gap-2" style="font-family: monospace; font-size: 12px; opacity: 0.9;">
                    <span>@selected.DocumentNumber</span>
                    @if (!string.IsNullOrWhiteSpace(selected.CustomerCif))
                    {
                        <span>· CIF: @selected.CustomerCif</span>
                    }
                </div>
                <h4 class="fw-bold mb-2 mt-1">@selected.CustomerName</h4>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(255,255,255,0.22); font-weight: 600;">
                        @(selected.CustomerType == "individual" ? "👤 Cá nhân" : "🏢 Công ty")
                    </span>
                    @if (IsDirectPdv)
                    {
                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(255,255,255,0.25); font-weight: 600;">
                            ⚡ Chuyển thẳng PDV
                        </span>
                    }
                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(255,255,255,0.18); font-weight: 500;">
                        @selected.CurrentDepartmentName
                    </span>
                    <span class="badge rounded-pill bg-white text-success px-3 py-1 fw-semibold">
                        @StatusLabel(selected.Status)
                    </span>
                </div>
            </div>

            @* 2. Drawer Body *@
            <div class="vcb-drawer-body">
                @if (actionError != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">@actionError</div>
                }
                @if (actionMessage != null)
                {
                    <div class="alert alert-success py-2 small mb-3">@actionMessage</div>
                }

                @* Stepper ngang theo luồng xử lý *@
                <div class="vcb-stepper">
                    @for (int idx = 0; idx < activeStepLabels.Length; idx++)
                    {
                        var sNumber = idx + 1;
                        var css = sNumber < stepIdx ? "done" : (sNumber == stepIdx ? (selected.Status == "Completed" ? "done" : "current") : "");
                        <div class="vcb-step @css">
                            <div class="vcb-step-circle">
                                @if (sNumber < stepIdx || (sNumber == activeStepLabels.Length && selected.Status == "Completed"))
                                {
                                    <span>✓</span>
                                }
                                else
                                {
                                    <span>@sNumber</span>
                                }
                            </div>
                            <div class="vcb-step-label">@activeStepLabels[idx]</div>
                        </div>
                    }
                </div>

                @* Thông tin phụ trách gọn *@
                <div class="vcb-surface p-3 mb-3 small">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <span class="text-muted">Mã CIF:</span> <b>@(string.IsNullOrWhiteSpace(selected.CustomerCif) ? "—" : selected.CustomerCif)</b>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Đối tượng:</span> <b>@(selected.CustomerType == "individual" ? "Khách hàng Cá nhân" : "Khách hàng Công ty")</b>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Luồng xử lý:</span>
                            <b>@(IsDirectPdv ? "Chuyển thẳng PDV (PKH → PDV)" : "Tiêu chuẩn (PKH → PQLN → PDV)")</b>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Hạn thanh toán:</span> <b class="text-danger">@FormatDate(selected.DueDate)</b>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">PKH khởi tạo:</span> <b>@(selected.CreatedByUserName ?? "—")</b>
                        </div>
                        @if (!IsDirectPdv)
                        {
                            <div class="col-md-6">
                                <span class="text-muted">PQLN xử lý:</span> <b>@(selected.PqlnReceiverName ?? "Chưa nhận")</b>
                            </div>
                        }
                        <div class="col-md-6">
                            <span class="text-muted">PDV xử lý:</span> <b>@(selected.PdvReceiverName ?? "Chưa nhận")</b>
                        </div>
                    </div>
                </div>

                @* Khối Chứng từ nợ *@
                <div class="vcb-surface p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold" style="font-size: 14.5px;">Chứng từ nợ</span>
                        <span class="small text-muted fw-semibold">
                            @(selected.DebtItems.Count == 0 ? "Không có" : $"{completedItemsCount}/{selected.DebtItems.Count} đã đủ")
                        </span>
                    </div>
                    <div class="vcb-progress-track w-100 mb-3" style="height: 5px;">
                        <div class="vcb-progress-fill" style="width: @(totalPct)%;"></div>
                    </div>

                    <div class="row g-3">
                        @* Cột CHỨNG TỪ PKH (Full width nếu luồng chuyển thẳng PDV) *@
                        <div class="@(IsDirectPdv ? "col-12" : "col-md-6")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.4px;">
                                    CHỨNG TỪ PKH
                                </span>
                                <span class="small text-muted fw-semibold" style="font-size: 11px;">
                                    @(IsDirectPdv
                                        ? pkhItems.Count(x => x.IsSupplemented && x.IsVerifiedByPdv)
                                        : pkhItems.Count(x => x.IsSupplemented && x.IsVerifiedByPqln))/@pkhItems.Count
                                </span>
                            </div>

                            @if (pkhItems.Count == 0)
                            {
                                <div class="text-muted small py-2">Không có chứng từ nợ PKH</div>
                            }
                            @foreach (var it in pkhItems)
                            {
                                var isVerified = IsDirectPdv ? it.IsVerifiedByPdv : it.IsVerifiedByPqln;
                                var verifiedAt = IsDirectPdv ? it.PdvVerifiedAt : it.PqlnVerifiedAt;
                                var verifierDept = IsDirectPdv ? "PDV" : "PQLN";

                                <div class="vcb-item-row">
                                    @if (editingItemId == it.Id)
                                    {
                                        <input class="form-control form-control-sm" @bind="editItemName" />
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-success py-0" @onclick="() => SaveEditItem(it)">Lưu</button>
                                            <button class="btn btn-sm btn-secondary py-0" @onclick="CancelEditItem">Hủy</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <div class="small fw-semibold">📄 @it.ItemName</div>
                                            @if (it.IsSupplemented)
                                            {
                                                <div class="text-muted mt-1" style="font-size: 11.5px;">
                                                    PKH bổ sung: <b>@(it.SupplementedAt.HasValue ? FormatFullVnTime(it.SupplementedAt.Value) : "—")</b>
                                                    @if (isVerified)
                                                    {
                                                        <span class="text-success d-block">@verifierDept xác nhận: <b>@(verifiedAt.HasValue ? FormatFullVnTime(verifiedAt.Value) : "—")</b></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-primary d-block"><i>Chờ @verifierDept xác nhận đã nhận</i></span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                            @if (!it.IsSupplemented)
                                            {
                                                <span class="vcb-status-pill pill-amber" style="font-size: 11.5px; padding: 2px 10px;">
                                                    <span class="dot"></span>Chưa bổ sung
                                                </span>
                                            }
                                            else if (!isVerified)
                                            {
                                                <span class="vcb-status-pill pill-blue" style="font-size: 11.5px; padding: 2px 10px;">
                                                    <span class="dot"></span>Chờ @verifierDept XN
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vcb-status-pill pill-green" style="font-size: 11.5px; padding: 2px 10px;">
                                                    <span class="dot"></span>Đã bổ sung
                                                </span>
                                            }
                                            @if (CanManagePkhItem && !it.IsSupplemented)
                                            {
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-link btn-sm p-0 text-primary text-decoration-none" style="font-size: 11.5px;" @onclick="() => StartEditItem(it)">Sửa</button>
                                                    <span class="text-muted">·</span>
                                                    <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none" style="font-size: 11.5px;" @onclick="() => DeleteDebtItem(it.Id)">Xóa</button>
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }

                            @if (CanManagePkhItem)
                            {
                                <div class="d-flex gap-2 mt-2">
                                    <input class="form-control form-control-sm rounded-3" @bind="addItemName" placeholder="Tên chứng từ PKH..." />
                                    <button class="btn btn-sm btn-outline-success rounded-3 fw-semibold flex-shrink-0" @onclick="AddDebtItem">+ Thêm</button>
                                </div>
                            }
                        </div>

                        @* Cột phải: Nhóm CHỨNG TỪ PQLN (Chỉ hiển thị ở luồng tiêu chuẩn) *@
                        @if (!IsDirectPdv)
                        {
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.4px;">
                                        CHỨNG TỪ PQLN
                                    </span>
                                    <span class="small text-muted fw-semibold" style="font-size: 11px;">
                                        @pqlnItems.Count(x => x.IsSupplemented && x.IsVerifiedByPdv)/@pqlnItems.Count
                                    </span>
                                </div>

                                @if (pqlnItems.Count == 0 && !CanManagePqlnItem)
                                {
                                    <div class="text-muted small py-2">Không có chứng từ nợ PQLN</div>
                                }
                                @foreach (var it in pqlnItems)
                                {
                                    <div class="vcb-item-row">
                                        @if (editingItemId == it.Id)
                                        {
                                            <input class="form-control form-control-sm" @bind="editItemName" />
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-success py-0" @onclick="() => SaveEditItem(it)">Lưu</button>
                                                <button class="btn btn-sm btn-secondary py-0" @onclick="CancelEditItem">Hủy</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <div class="small fw-semibold">📄 @it.ItemName</div>
                                                @if (it.IsSupplemented)
                                                {
                                                    <div class="text-muted mt-1" style="font-size: 11.5px;">
                                                        PQLN bổ sung: <b>@(it.SupplementedAt.HasValue ? FormatFullVnTime(it.SupplementedAt.Value) : "—")</b>
                                                        @if (it.IsVerifiedByPdv)
                                                        {
                                                            <span class="text-success d-block">PDV xác nhận: <b>@(it.PdvVerifiedAt.HasValue ? FormatFullVnTime(it.PdvVerifiedAt.Value) : "—")</b></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-primary d-block"><i>Chờ PDV xác nhận đã nhận</i></span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                                @if (!it.IsSupplemented)
                                                {
                                                    <span class="vcb-status-pill pill-amber" style="font-size: 11.5px; padding: 2px 10px;">
                                                        <span class="dot"></span>Chưa bổ sung
                                                    </span>
                                                }
                                                else if (!it.IsVerifiedByPdv)
                                                {
                                                    <span class="vcb-status-pill pill-blue" style="font-size: 11.5px; padding: 2px 10px;">
                                                        <span class="dot"></span>Chờ PDV XN
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="vcb-status-pill pill-green" style="font-size: 11.5px; padding: 2px 10px;">
                                                        <span class="dot"></span>Đã bổ sung
                                                    </span>
                                                }
                                                @if (CanManagePqlnItem && !it.IsSupplemented)
                                                {
                                                    <div class="d-flex gap-1">
                                                        <button class="btn btn-link btn-sm p-0 text-primary text-decoration-none" style="font-size: 11.5px;" @onclick="() => StartEditItem(it)">Sửa</button>
                                                        <span class="text-muted">·</span>
                                                        <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none" style="font-size: 11.5px;" @onclick="() => DeleteDebtItem(it.Id)">Xóa</button>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (CanManagePqlnItem)
                                {
                                    <div class="d-flex gap-2 mt-2">
                                        <input class="form-control form-control-sm rounded-3" @bind="addItemName" placeholder="Tên chứng từ PQLN..." />
                                        <button class="btn btn-sm btn-outline-success rounded-3 fw-semibold flex-shrink-0" @onclick="AddDebtItem">+ Thêm</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @* Khung tích bổ sung của NV phụ trách *@
                    @if (SupplementableItems.Any())
                    {
                        <div class="mt-3 p-2 rounded-3 border border-success bg-success-subtle">
                            <div class="small fw-semibold text-success-emphasis mb-1">Đánh dấu đã bổ sung chứng từ (@Dept):</div>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var it in SupplementableItems)
                                {
                                    <div class="form-check small">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@suppIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleSupp(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label">@it.ItemName</label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-success mt-2 fw-semibold" @onclick="SupplementItems" disabled="@(suppIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận bổ sung (@suppIds.Count)
                            </button>
                        </div>
                    }

                    @* Khung PQLN (hoặc PDV nếu chuyển thẳng) xác nhận nhận CT từ PKH *@
                    @if (VerifiablePkhItems.Any())
                    {
                        <div class="mt-3 p-2 rounded-3 border border-info bg-info-subtle">
                            <div class="small fw-semibold text-info-emphasis mb-1">
                                @(IsDirectPdv ? "PDV xác nhận đã nhận chứng từ từ PKH:" : "PQLN xác nhận đã nhận chứng từ từ PKH:")
                            </div>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var it in VerifiablePkhItems)
                                {
                                    <div class="form-check small">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@verifyIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleVerify(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label">@it.ItemName</label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-primary mt-2 fw-semibold" @onclick="VerifyPkhItems" disabled="@(verifyIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận đã nhận từ PKH (@verifyIds.Count)
                            </button>
                        </div>
                    }

                    @* Khung PDV xác nhận nhận CT từ PQLN *@
                    @if (VerifiablePqlnItems.Any())
                    {
                        <div class="mt-3 p-2 rounded-3 border border-primary bg-primary-subtle">
                            <div class="small fw-semibold text-primary-emphasis mb-1">PDV xác nhận đã nhận chứng từ từ PQLN:</div>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var it in VerifiablePqlnItems)
                                {
                                    <div class="form-check small">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@verifyPqlnIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleVerifyPqln(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label">@it.ItemName</label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-primary mt-2 fw-semibold" @onclick="VerifyPqlnItems" disabled="@(verifyPqlnIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận đã nhận từ PQLN (@verifyPqlnIds.Count)
                            </button>
                        </div>
                    }
                </div>

                @* Luồng theo dõi lịch sử (Mới nhất lên trên cùng) *@
                @{
                    var orderedHistory = selected.CirculationHistory
                        .OrderByDescending(x => x.CreatedAt)
                        .ToList();
                }
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold" style="font-size: 15px;">Luồng theo dõi</span>
                    <span class="text-muted" style="font-size: 11.5px;">Mới nhất ở trên</span>
                </div>

                <div class="vcb-surface p-3 px-4">
                    <div class="vcb-timeline">
                        @for (int i = 0; i < orderedHistory.Count; i++)
                        {
                            var h = orderedHistory[i];
                            var isLatest = i == 0;
                            var deptFlow = FormatHistoryDeptFlow(h);

                            <div class="vcb-tl-item @(isLatest ? "latest" : "")">
                                <span class="vcb-tl-dot"></span>

                                <div class="d-flex flex-wrap align-items-baseline gap-2">
                                    <span class="vcb-tl-title">@FormatHistoryActionLabel(h)</span>
                                    <span class="vcb-tl-time">@FormatFullVnTime(h.CreatedAt)</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(h.Notes))
                                {
                                    <div class="vcb-tl-note">@h.Notes</div>
                                }

                                <div class="vcb-tl-meta">
                                    <span>👤 @h.PerformedByUserName</span>
                                    @if (!string.IsNullOrEmpty(deptFlow))
                                    {
                                        <span>·</span>
                                        <span>@deptFlow</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* 3. Drawer Footer — Thanh thao tác cố định dưới đáy *@
            <div class="vcb-drawer-footer">
                @if (CanApprovePkh)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú duyệt PKH..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ApprovePkh">
                        ✓ Duyệt hồ sơ PKH →
                    </button>
                }
                else if (CanReceivePqln)
                {
                    <span class="small text-muted">Hồ sơ đang chờ phòng PQLN tiếp nhận</span>
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ReceivePqln">
                        Tiếp nhận hồ sơ PQLN
                    </button>
                }
                else if (CanSubmitPqln)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú trình SUP PQLN..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="SubmitPqln">
                        ➤ Trình SUP PQLN
                    </button>
                }
                else if (CanApprovePqln)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú duyệt PQLN..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ApprovePqln">
                        ✓ Duyệt hồ sơ PQLN →
                    </button>
                }
                else if (CanReceivePdv)
                {
                    <span class="small text-muted">Hồ sơ đang chờ phòng PDV tiếp nhận</span>
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ReceivePdv">
                        Tiếp nhận hồ sơ PDV
                    </button>
                }
                else if (CanPostEntry)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú đi bút toán..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="PostEntry">
                        Xác nhận đi bút toán →
                    </button>
                }
                else if (CanApprovePdv)
                {
                    var unsupCount = selected.DebtItems.Count(x => !IsItemFullyCompleted(x, IsDirectPdv));
                    var blocked = St == "PdvEntryApproved" && unsupCount > 0;
                    var btnLabel = St == "PdvEntryPosted"
                        ? (unsupCount > 0 ? "✓ Duyệt bút toán (Lần 1)" : "✓ Duyệt hoàn tất hồ sơ")
                        : "✓ Duyệt hoàn tất (Lần 2)";

                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú duyệt PDV..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@(isSubmitting || blocked)" @onclick="ApprovePdv">
                        @btnLabel
                    </button>
                }
                else
                {
                    <span class="small text-muted">@GetFooterStatusHint(selected)</span>
                    <button type="button" class="btn btn-sm bg-white border rounded-3 px-3 flex-shrink-0" style="height: 36px;" @onclick="Close">
                        Đóng
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    string email = "", password = "";
    bool showPassword;
    bool showCreateModal;
    string? loginError;
    string? createError;
    string? actionMessage;
    string? actionError;
    bool isSubmitting;
    string searchText = "";
    string filterStatus = "";
    string filterDept = "";
    string quickTab = "mine";
    List<DebtDocumentDto> docs = new();
    DebtDocumentDetailDto? selected;
    List<AppUserDto> allUsers = new();
    bool showUsers;

    string newName = "",
           newCif = "",
           newCustomerType = "company",
           newWorkflowType = "pkh_pqln_pdv",
           newIssue = DateTime.UtcNow.AddHours(7).ToString("yyyy-MM-dd"),
           newDue = DateTime.UtcNow.AddHours(7).AddDays(30).ToString("yyyy-MM-dd");
    bool newHasDebt;
    List<CreateDebtItemRequest> newItems = new();
    string addItemName = "";
    string approvalNote = "";
    HashSet<Guid> suppIds = new();
    HashSet<Guid> verifyIds = new();
    HashSet<Guid> verifyPqlnIds = new();
    Guid? editingItemId;
    string editItemName = "";

    // Bảng danh sách dùng chung cho cả 2 khu vực Công ty & Cá nhân
    RenderFragment<List<DebtDocumentDto>> RenderDocumentTable => docList =>
    @<div class="table-responsive">
        <table class="table vcb-table mb-0">
            <thead>
                <tr>
                    <th>HỒ SƠ / KHÁCH HÀNG</th>
                    <th>NGƯỜI PHỤ TRÁCH</th>
                    <th>PHÒNG & TRẠNG THÁI</th>
                    <th>CHỨNG TỪ NỢ</th>
                    <th>THỜI GIAN</th>
                    <th class="text-end">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in docList)
                {
                    var actionLabel = GetMyActionLabel(d);
                    var isMyTurn = actionLabel != null;
                    var isOverdue = IsOverdue(d);
                    var pct = d.TotalDebtItems == 0 ? 100 : (int)Math.Round(100.0 * d.SupplementedDebtItems / d.TotalDebtItems);

                    <tr class="@(isMyTurn ? "vcb-row-action" : "")" style="cursor: pointer;" @onclick="() => ViewAsync(d.Id)">
                        @* 1. Số VB + Khách hàng + CIF *@
                        <td>
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                <span class="fw-semibold text-muted" style="font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px;">
                                    @d.DocumentNumber
                                </span>
                                @if (d.WorkflowType == "pkh_pdv")
                                {
                                    <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle" style="font-size: 10.5px;">
                                        Chuyển thẳng PDV
                                    </span>
                                }
                                @if (d.Priority is "high" or "urgent")
                                {
                                    <span class="badge bg-danger" style="font-size: 10.5px;">Khẩn</span>
                                }
                            </div>
                            <div class="fw-bold mt-1" style="font-size: 14px;">
                                @d.CustomerName
                                @if (!string.IsNullOrWhiteSpace(d.CustomerCif))
                                {
                                    <span class="fw-normal text-muted" style="font-size: 12.5px;"> · CIF: @d.CustomerCif</span>
                                }
                            </div>
                        </td>

                        @* 2. Người phụ trách (Hồ sơ của ai) *@
                        <td>
                            <div class="fw-semibold" style="font-size: 13.5px;">
                                @CurrentHandlerText(d)
                            </div>
                            <div class="text-muted mt-1" style="font-size: 12px;">
                                Tạo PKH: @(d.CreatedByUserName ?? "—")
                            </div>
                        </td>

                        @* 3. Phòng & Trạng thái *@
                        <td>
                            <div class="d-flex flex-wrap align-items-center gap-1">
                                <span class="vcb-dept-pill">@d.CurrentDepartmentCode</span>
                                <span class="vcb-status-pill @StatusPillClass(d.Status)">
                                    <span class="dot"></span>
                                    @StatusLabel(d.Status)
                                </span>
                            </div>
                        </td>

                        @* 4. Chứng từ nợ *@
                        <td>
                            @if (d.TotalDebtItems == 0)
                            {
                                <span class="text-muted small">Không có</span>
                            }
                            else
                            {
                                <div class="d-flex align-items-center gap-2">
                                    <div class="vcb-progress-track">
                                        <div class="vcb-progress-fill" style="width: @(pct)%;"></div>
                                    </div>
                                    <span class="small fw-semibold @(d.SupplementedDebtItems >= d.TotalDebtItems ? "text-success" : "text-muted")">
                                        @d.SupplementedDebtItems/@d.TotalDebtItems
                                    </span>
                                </div>
                            }
                        </td>

                        @* 5. Mốc thời gian *@
                        <td style="font-size: 12.5px;">
                            <div class="text-muted">CN: @FormatVnTime(d.UpdatedAt)</div>
                            <div class="mt-1 @(isOverdue ? "text-danger fw-bold" : "text-muted")">
                                Hạn: @FormatDate(d.DueDate) @(isOverdue ? "(Quá hạn)" : "")
                            </div>
                        </td>

                        @* 6. Nút thao tác rõ nghĩa *@
                        <td class="text-end">
                            @if (isMyTurn)
                            {
                                <span class="badge rounded-pill px-3 py-2 text-white" style="background: #0a7a42; font-size: 12px;">
                                    @actionLabel →
                                </span>
                            }
                            else
                            {
                                <span class="text-success fw-semibold small">Xem ›</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>;

    static readonly string[] StandardStepLabels =
    [
        "Khởi tạo",
        "SUP PKH duyệt",
        "PQLN đang xử lý",
        "SUP PQLN duyệt",
        "PDV đang xử lý",
        "SUP PDV duyệt",
        "Hoàn tất"
    ];

    static readonly string[] DirectPdvStepLabels =
    [
        "Khởi tạo",
        "SUP PKH duyệt",
        "PDV đang xử lý",
        "SUP PDV duyệt",
        "Hoàn tất"
    ];

    static string[] GetStepLabels(bool isDirectPdv)
        => isDirectPdv ? DirectPdvStepLabels : StandardStepLabels;

    static int CurrentStepIndex(string status, bool isDirectPdv) => isDirectPdv
        ? status switch
        {
            "PkhPendingSup" => 1,
            "PdvPendingReceive" => 2,
            "PdvReceived" or "PdvEntryPosted" => 3,
            "PdvEntryApproved" => 4,
            "Completed" => 5,
            _ => 1
        }
        : status switch
        {
            "PkhPendingSup" => 1,
            "PqlnPendingReceive" => 2,
            "PqlnReceived" or "PqlnPendingSup" => 3,
            "PdvPendingReceive" => 4,
            "PdvReceived" or "PdvEntryPosted" => 5,
            "PdvEntryApproved" => 6,
            "Completed" => 7,
            _ => 1
        };

    string FormatHistoryActionLabel(CirculationHistoryDto h)
    {
        var note = (h.Notes ?? "").ToLower();
        if (note.Contains("khởi tạo")) return "Khởi tạo";
        if (h.Action == "PkhSupApproved" || note.Contains("sup pkh") || (note.Contains("sup duyệt") && (IsDirectPdv || note.Contains("khách hàng")))) return "SUP PKH duyệt";
        if (note.Contains("sup duyệt")) return "SUP duyệt";
        if (note.Contains("tiếp nhận") && note.Contains("pqln")) return "PQLN tiếp nhận";
        if (note.Contains("tiếp nhận") && note.Contains("pdv")) return "PDV tiếp nhận";
        if (note.Contains("gửi sup pqln") || note.Contains("trình sup pqln")) return "Trình SUP PQLN";
        if (note.Contains("bút toán") && note.Contains("duyệt")) return "SUP PDV duyệt";
        if (note.Contains("bút toán")) return "Đi bút toán";
        if (note.Contains("hoàn tất")) return "Duyệt hoàn tất";
        if (note.Contains("xác nhận") && note.Contains("chứng từ")) return "Xác nhận chứng từ";
        if (note.Contains("bổ sung")) return "Bổ sung";
        if (note.Contains("sửa tên chứng từ") || note.Contains("sửa chứng từ")) return "Sửa chứng từ";
        if (note.Contains("xóa chứng từ")) return "Xóa chứng từ";
        if (note.Contains("thêm chứng từ")) return "Thêm chứng từ";
        return "Cập nhật hồ sơ";
    }

    string FormatHistoryDeptFlow(CirculationHistoryDto h)
    {
        if (h.FromDepartmentId.HasValue && h.ToDepartmentId.HasValue && h.FromDepartmentId != h.ToDepartmentId
            && !string.IsNullOrWhiteSpace(h.FromDepartmentName) && !string.IsNullOrWhiteSpace(h.ToDepartmentName))
        {
            return $"{h.FromDepartmentName} → {h.ToDepartmentName}";
        }

        var note = (h.Notes ?? "").ToLower();

        if (note.Contains("khởi tạo")) return "Phòng Khách hàng";

        if (note.Contains("sup duyệt") || h.Action == "PkhSupApproved")
        {
            if (IsDirectPdv)
                return "Phòng Khách hàng → Phòng Dịch vụ khách hàng";

            var pkhApprovedAt = selected?.CirculationHistory
                .Where(x => (x.Notes ?? "").ToLower().Contains("sup duyệt") || x.Action == "PkhSupApproved")
                .OrderBy(x => x.CreatedAt)
                .FirstOrDefault()?.CreatedAt;

            return pkhApprovedAt.HasValue && h.CreatedAt > pkhApprovedAt.Value
                ? "Phòng Quản lý nợ → Phòng Dịch vụ khách hàng"
                : "Phòng Khách hàng → Phòng Quản lý nợ";
        }

        // Các thao tác nội bộ tại từng phòng (không có mũi tên)
        if (note.Contains("pqln")) return "Phòng Quản lý nợ";
        if (note.Contains("pdv") || note.Contains("bút toán")) return "Phòng Dịch vụ khách hàng";

        // Với các thao tác chung (Sửa/Xóa/Bổ sung...), xác định đúng phòng dựa theo mốc duyệt chuyển phòng trước đó
        if (selected != null)
        {
            var supApprovals = selected.CirculationHistory
                .Where(x => (x.Notes ?? "").ToLower().Contains("sup duyệt") || x.Action is "PkhSupApproved" or "PqlnSupApproved")
                .OrderBy(x => x.CreatedAt)
                .ToList();

            if (IsDirectPdv)
            {
                if (supApprovals.Count >= 1 && h.CreatedAt > supApprovals[0].CreatedAt)
                    return "Phòng Dịch vụ khách hàng";
            }
            else
            {
                if (supApprovals.Count >= 2 && h.CreatedAt > supApprovals[1].CreatedAt)
                    return "Phòng Dịch vụ khách hàng";
                if (supApprovals.Count >= 1 && h.CreatedAt > supApprovals[0].CreatedAt)
                    return "Phòng Quản lý nợ";
            }
        }

        return "Phòng Khách hàng";
    }

    string Dept => Session.CurrentUser?.DepartmentCode ?? "";
    string St => selected?.Status ?? "";
    bool IsDirectPdv => selected?.WorkflowType == "pkh_pdv";
    bool R(string r) => Session.CurrentUser?.Role == r;

    static bool IsItemFullyCompleted(DebtItemDto x, bool isDirectPdv)
    {
        if (!x.IsSupplemented) return false;
        if (isDirectPdv) return x.IsVerifiedByPdv;

        var deptCode = x.SourceDepartmentCode ?? "PKH";
        return deptCode switch
        {
            "PKH" => x.IsVerifiedByPqln,
            "PQLN" => x.IsVerifiedByPdv,
            _ => true
        };
    }

    string GetFooterStatusHint(DebtDocumentDetailDto d) => d.Status switch
    {
        "PkhPendingSup" => "Đang chờ Lãnh đạo PKH (SUP PKH) phê duyệt",
        "PqlnPendingReceive" => "Đã duyệt PKH — Đang chờ cán bộ PQLN tiếp nhận",
        "PqlnReceived" => $"Đang được {d.PqlnReceiverName ?? "cán bộ PQLN"} thụ lý",
        "PqlnPendingSup" => "Đang chờ Lãnh đạo PQLN (SUP PQLN) phê duyệt",
        "PdvPendingReceive" => d.WorkflowType == "pkh_pdv"
            ? "Đã duyệt PKH — Đang chờ cán bộ PDV tiếp nhận"
            : "Đã duyệt PQLN — Đang chờ cán bộ PDV tiếp nhận",
        "PdvReceived" => $"Đang được {d.PdvReceiverName ?? "cán bộ PDV"} thụ lý & đi bút toán",
        "PdvEntryPosted" => "Đã đi bút toán — Đang chờ Lãnh đạo PDV duyệt",
        "PdvEntryApproved" => "Đã duyệt bút toán — Đang chờ bổ sung & xác nhận đủ chứng từ nợ",
        "Completed" => "Hồ sơ đã hoàn tất toàn bộ quy trình",
        _ => "Hồ sơ đang ở bước xử lý khác"
    };

    bool CanApprovePkh => selected != null && Dept == "PKH" && R("manager") && St == "PkhPendingSup";
    bool CanReceivePqln => selected != null && !IsDirectPdv && Dept == "PQLN" && R("staff") && St == "PqlnPendingReceive";
    bool CanSubmitPqln => selected != null && !IsDirectPdv && Dept == "PQLN" && R("staff") && St == "PqlnReceived" && selected.PqlnReceiverId == Session.CurrentUser?.Id;
    bool CanApprovePqln => selected != null && !IsDirectPdv && Dept == "PQLN" && R("manager") && St == "PqlnPendingSup";
    bool CanReceivePdv => selected != null && Dept == "PDV" && R("staff") && St == "PdvPendingReceive";
    bool CanPostEntry => selected != null && Dept == "PDV" && R("staff") && St == "PdvReceived" && selected.PdvReceiverId == Session.CurrentUser?.Id;
    bool CanApprovePdv => selected != null && Dept == "PDV" && R("manager") && (St == "PdvEntryPosted" || St == "PdvEntryApproved");

    bool CanSupplement => selected != null
        && Session.CurrentUser != null
        && R("staff")
        && ((Dept == "PKH" && selected.CreatedByUserId == Session.CurrentUser.Id)
            || (!IsDirectPdv && Dept == "PQLN" && selected.PqlnReceiverId == Session.CurrentUser.Id));

    IEnumerable<DebtItemDto> SupplementableItems => selected == null || !CanSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => !x.IsSupplemented && (x.SourceDepartmentCode ?? "PKH") == Dept);

    bool CanVerifyPkhSupplement => selected != null
        && Session.CurrentUser != null
        && R("staff")
        && (IsDirectPdv
            ? (Dept == "PDV" && selected.PdvReceiverId == Session.CurrentUser.Id)
            : (Dept == "PQLN" && selected.PqlnReceiverId == Session.CurrentUser.Id));

    IEnumerable<DebtItemDto> VerifiablePkhItems => selected == null || !CanVerifyPkhSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => (x.SourceDepartmentCode ?? "PKH") == "PKH"
                                     && x.IsSupplemented
                                     && (IsDirectPdv ? !x.IsVerifiedByPdv : !x.IsVerifiedByPqln));

    bool CanVerifyPqlnSupplement => selected != null
        && !IsDirectPdv
        && Session.CurrentUser != null
        && R("staff")
        && Dept == "PDV"
        && selected.PdvReceiverId == Session.CurrentUser.Id;

    IEnumerable<DebtItemDto> VerifiablePqlnItems => selected == null || !CanVerifyPqlnSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => x.SourceDepartmentCode == "PQLN"
                                     && x.IsSupplemented
                                     && !x.IsVerifiedByPdv);

    bool CanManagePkhItem => selected != null && Dept == "PKH" && R("staff") && St == "PkhPendingSup" && selected.CreatedByUserId == Session.CurrentUser?.Id;
    bool CanManagePqlnItem => selected != null && !IsDirectPdv && Dept == "PQLN" && R("staff") && (St == "PqlnReceived" || St == "PqlnPendingSup") && selected.PqlnReceiverId == Session.CurrentUser?.Id;

    int MyActionCount => docs.Count(IsActionRequiredForMe);

    bool IsActionRequiredForMe(DebtDocumentDto d) => GetMyActionLabel(d) != null;

    string? GetMyActionLabel(DebtDocumentDto d)
    {
        var u = Session.CurrentUser;
        if (u == null || d.Status == "Completed") return null;

        if (u.Role == "manager")
        {
            if (u.DepartmentCode == "PKH" && d.Status == "PkhPendingSup") return "Duyệt PKH";
            if (u.DepartmentCode == "PQLN" && d.WorkflowType != "pkh_pdv" && d.Status == "PqlnPendingSup") return "Duyệt PQLN";
            if (u.DepartmentCode == "PDV" && d.Status == "PdvEntryPosted")
                return d.TotalDebtItems > d.SupplementedDebtItems ? "Duyệt bút toán" : "Duyệt hoàn tất";
            if (u.DepartmentCode == "PDV" && d.Status == "PdvEntryApproved" && d.TotalDebtItems <= d.SupplementedDebtItems)
                return "Duyệt hoàn tất";
            return null;
        }

        if (u.Role == "staff")
        {
            if (u.DepartmentCode == "PKH" && d.CreatedByUserId == u.Id && d.TotalDebtItems > d.SupplementedDebtItems)
                return "Bổ sung CT";

            if (u.DepartmentCode == "PQLN" && d.WorkflowType != "pkh_pdv")
            {
                if (d.Status == "PqlnPendingReceive") return "Tiếp nhận";
                if (d.PqlnReceiverId == u.Id)
                {
                    if (d.Status == "PqlnReceived") return "Đẩy SUP PQLN";
                    if (d.TotalDebtItems > d.SupplementedDebtItems) return "Bổ sung / XN CT";
                }
            }

            if (u.DepartmentCode == "PDV")
            {
                if (d.Status == "PdvPendingReceive") return "Tiếp nhận";
                if (d.PdvReceiverId == u.Id)
                {
                    if (d.Status == "PdvReceived") return "Đi bút toán";
                    if (d.TotalDebtItems > d.SupplementedDebtItems) return "Xác nhận CT";
                }
            }
        }

        return null;
    }

    List<DebtDocumentDto> filtered => docs
        .Where(d =>
        {
            if (quickTab == "mine" && !IsActionRequiredForMe(d)) return false;
            if (quickTab == "active" && d.Status == "Completed") return false;
            if (quickTab == "completed" && d.Status != "Completed") return false;

            if (!string.IsNullOrEmpty(filterDept) && d.CurrentDepartmentCode != filterDept) return false;

            if (filterStatus == "pending" && d.Status is not ("PkhPendingSup" or "PqlnPendingReceive" or "PqlnPendingSup" or "PdvPendingReceive")) return false;
            if (filterStatus == "processing" && d.Status is not ("PqlnReceived" or "PdvReceived" or "PdvEntryPosted")) return false;
            if (filterStatus == "supplement" && !(d.TotalDebtItems > d.SupplementedDebtItems)) return false;
            if (filterStatus == "completed" && d.Status != "Completed") return false;

            if (!string.IsNullOrWhiteSpace(searchText))
            {
                var q = searchText.Trim().ToLower();
                var match = d.DocumentNumber.ToLower().Contains(q)
                         || d.CustomerName.ToLower().Contains(q)
                         || (d.CustomerCif?.ToLower().Contains(q) ?? false)
                         || (d.CreatedByUserName?.ToLower().Contains(q) ?? false)
                         || (d.PqlnReceiverName?.ToLower().Contains(q) ?? false)
                         || (d.PdvReceiverName?.ToLower().Contains(q) ?? false);
                if (!match) return false;
            }
            return true;
        })
        .OrderByDescending(IsActionRequiredForMe)
        .ThenByDescending(d => d.UpdatedAt)
        .ToList();

    string CurrentHandlerText(DebtDocumentDto d) => d.Status switch
    {
        "PkhPendingSup" => $"Chờ SUP PKH ({d.CreatedByUserName})",
        "PqlnPendingReceive" => "PQLN: Chờ tiếp nhận",
        "PqlnReceived" or "PqlnPendingSup" => $"PQLN: {d.PqlnReceiverName ?? "—"}",
        "PdvPendingReceive" => "PDV: Chờ tiếp nhận",
        "PdvReceived" or "PdvEntryPosted" or "PdvEntryApproved" => $"PDV: {d.PdvReceiverName ?? "—"}",
        "Completed" => $"Hoàn tất ({d.PdvReceiverName ?? d.CreatedByUserName})",
        _ => d.CreatedByUserName ?? "—"
    };

    string GetInitials(string? fullName)
    {
        if (string.IsNullOrWhiteSpace(fullName)) return "VC";
        var parts = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1
            ? parts[0][..Math.Min(2, parts[0].Length)].ToUpper()
            : $"{parts[^2][0]}{parts[^1][0]}".ToUpper();
    }

    string RoleLabel(string? role) => role switch
    {
        "staff" => "Cán bộ nghiệp vụ",
        "manager" => "Lãnh đạo phòng (SUP)",
        "admin" => "Quản trị hệ thống",
        _ => role ?? ""
    };

    string FormatVnTime(DateTime dt) => ToVnTime(dt).ToString("dd/MM HH:mm");

    bool IsOverdue(DebtDocumentDto d)
        => d.Status != "Completed"
        && DateOnly.TryParse(d.DueDate, out var due)
        && due < DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));

    string StatusPillClass(string s) => s switch
    {
        "Completed" => "pill-green",
        "PqlnReceived" or "PdvReceived" or "PdvEntryPosted" => "pill-blue",
        "PdvEntryApproved" or "PkhPendingSup" or "PqlnPendingReceive" or "PqlnPendingSup" or "PdvPendingReceive" => "pill-amber",
        _ => "pill-gray"
    };

    string StatusLabel(string s) => s switch
    {
        "PkhPendingSup" => "Chờ SUP PKH",
        "PqlnPendingReceive" => "Chờ PQLN nhận",
        "PqlnReceived" => "PQLN tiếp nhận",
        "PqlnPendingSup" => "Chờ SUP PQLN",
        "PdvPendingReceive" => "Chờ PDV nhận",
        "PdvReceived" => "PDV tiếp nhận",
        "PdvEntryPosted" => "Chờ SUP PDV duyệt",
        "PdvEntryApproved" => "Chờ bổ sung CT",
        "Completed" => "Hoàn tất",
        _ => s
    };

    DateTime ToVnTime(DateTime dt) =>
        dt.Kind == DateTimeKind.Local ? dt.ToUniversalTime().AddHours(7) : dt.AddHours(7);

    string FormatFullVnTime(DateTime dt) => ToVnTime(dt).ToString("dd/MM/yyyy HH:mm:ss");
    string FormatDate(string yyyyMmDd) => DateOnly.TryParse(yyyyMmDd, out var date) ? date.ToString("dd/MM/yyyy") : yyyyMmDd;

    protected override async Task OnInitializedAsync() { await Session.InitializeAsync(); if (Session.IsAuthenticated) await LoadAsync(); }
    async Task LoginAsync() { loginError = await Session.LoginAsync(email, password); if (loginError == null) await LoadAsync(); }
    async Task Logout() { await Session.LogoutAsync(); docs.Clear(); selected = null; }

    async Task LoadAsync()
    {
        if (Session.CurrentUser != null)
        {
            if (Session.CurrentUser.Role == "admin") quickTab = "all";
            docs = (await DocService.GetAllAsync(null, null, null, Session.CurrentUser.Id)).ToList();
        }
    }

    async Task ViewAsync(Guid id)
    {
        suppIds.Clear();
        verifyIds.Clear();
        verifyPqlnIds.Clear();
        approvalNote = "";
        CancelEditItem();
        actionMessage = null;
        actionError = null;
        if (Session.CurrentUser != null)
            selected = await DocService.GetByIdAsync(id, Session.CurrentUser.Id);
    }

    void Close()
    {
        CancelEditItem();
        approvalNote = "";
        suppIds.Clear();
        verifyIds.Clear();
        verifyPqlnIds.Clear();
        selected = null;
    }

    async Task ToggleUsers() { showUsers = !showUsers; if (showUsers) allUsers = (await UserService.GetAllAsync()).ToList(); }

    async Task CreateDoc()
    {
        if (string.IsNullOrWhiteSpace(newName))
        {
            createError = newCustomerType == "company" ? "Vui lòng nhập tên công ty" : "Vui lòng nhập họ và tên khách hàng";
            return;
        }
        try
        {
            var nowVn = DateTime.UtcNow.AddHours(7);
            await DocService.CreateAsync(new CreateDebtDocumentRequest
            {
                CustomerName = newName.Trim(),
                CustomerCif = string.IsNullOrWhiteSpace(newCif) ? null : newCif.Trim(),
                CustomerType = newCustomerType,
                WorkflowType = newWorkflowType,
                IssueDate = newIssue,
                DueDate = newDue,
                Priority = "normal",
                HasDebtDocuments = newHasDebt,
                DebtItems = newItems
            }, Session.CurrentUser!.Id);

            newName = "";
            newCif = "";
            newCustomerType = "company";
            newWorkflowType = "pkh_pqln_pdv";
            newIssue = nowVn.ToString("yyyy-MM-dd");
            newDue = nowVn.AddDays(30).ToString("yyyy-MM-dd");
            newItems.Clear();
            newHasDebt = false;
            createError = null;
            showCreateModal = false;
            await LoadAsync();
        }
        catch (Exception e) { createError = e.Message; }
    }

    async Task AddDebtItem()
    {
        if (selected == null || Session.CurrentUser == null || string.IsNullOrWhiteSpace(addItemName)) return;
        actionError = null;
        try
        {
            await DocService.AddDebtItemsAsync(
                selected.Id,
                new AddDebtItemsRequest(new List<CreateDebtItemRequest> { new CreateDebtItemRequest { ItemName = addItemName.Trim() } }, $"Thêm chứng từ nợ tại {Dept}"),
                Session.CurrentUser.Id);
            addItemName = "";
            await ViewAsync(selected.Id);
            await LoadAsync();
            actionMessage = "Đã thêm chứng từ nợ";
        }
        catch (Exception e) { actionError = e.Message; }
    }

    void StartEditItem(DebtItemDto it) { editingItemId = it.Id; editItemName = it.ItemName; }
    void CancelEditItem() { editingItemId = null; editItemName = ""; }

    async Task SaveEditItem(DebtItemDto it)
    {
        if (selected == null || Session.CurrentUser == null) return;
        if (string.IsNullOrWhiteSpace(editItemName)) { actionError = "Tên chứng từ không được để trống"; return; }
        actionError = null;
        try
        {
            await DocService.UpdateDebtItemAsync(selected.Id, it.Id, new UpdateDebtItemRequest(editItemName.Trim(), it.Notes), Session.CurrentUser.Id);
            CancelEditItem();
            await ViewAsync(selected.Id);
            actionMessage = "Đã cập nhật tên chứng từ nợ";
        }
        catch (Exception e) { actionError = e.Message; }
    }

    async Task DeleteDebtItem(Guid itemId)
    {
        if (selected == null || Session.CurrentUser == null) return;
        actionError = null;
        try
        {
            await DocService.DeleteDebtItemAsync(selected.Id, itemId, Session.CurrentUser.Id);
            suppIds.Remove(itemId);
            await ViewAsync(selected.Id);
            await LoadAsync();
            actionMessage = "Đã xóa chứng từ nợ";
        }
        catch (Exception e) { actionError = e.Message; }
    }

    void ToggleSupp(Guid id, bool check) { if (check) suppIds.Add(id); else suppIds.Remove(id); }

    async Task SupplementItems()
    {
        if (selected == null || suppIds.Count == 0 || isSubmitting) return;
        isSubmitting = true;
        actionError = null;
        actionMessage = null;
        try
        {
            await DocService.SupplementItemsAsync(selected.Id, new SupplementItemsRequest(suppIds.ToList(), "Bổ sung chứng từ nợ"), Session.CurrentUser!.Id);
            suppIds.Clear();
            await ViewAsync(selected.Id);
            await LoadAsync();
            actionMessage = "Bổ sung thành công";
        }
        catch (Exception e) { actionError = e.Message; }
        finally { isSubmitting = false; }
    }

    void ToggleVerify(Guid id, bool check) { if (check) verifyIds.Add(id); else verifyIds.Remove(id); }

    async Task VerifyPkhItems()
    {
        if (selected == null || verifyIds.Count == 0 || isSubmitting) return;
        isSubmitting = true;
        actionError = null;
        actionMessage = null;
        try
        {
            await DocService.VerifySupplementItemsAsync(selected.Id, new VerifySupplementItemsRequest(verifyIds.ToList()), Session.CurrentUser!.Id);
            verifyIds.Clear();
            await ViewAsync(selected.Id);
            await LoadAsync();
            actionMessage = IsDirectPdv
                ? "Đã xác nhận nhận chứng từ bổ sung từ PKH (PDV)"
                : "Đã xác nhận nhận chứng từ bổ sung từ PKH";
        }
        catch (Exception e) { actionError = e.Message; }
        finally { isSubmitting = false; }
    }

    void ToggleVerifyPqln(Guid id, bool check) { if (check) verifyPqlnIds.Add(id); else verifyPqlnIds.Remove(id); }

    async Task VerifyPqlnItems()
    {
        if (selected == null || verifyPqlnIds.Count == 0 || isSubmitting) return;
        isSubmitting = true;
        actionError = null;
        actionMessage = null;
        try
        {
            await DocService.VerifyPqlnSupplementItemsAsync(selected.Id, new VerifyPqlnSupplementItemsRequest(verifyPqlnIds.ToList()), Session.CurrentUser!.Id);
            verifyPqlnIds.Clear();
            await ViewAsync(selected.Id);
            await LoadAsync();
            actionMessage = "Đã xác nhận nhận chứng từ bổ sung từ PQLN";
        }
        catch (Exception e) { actionError = e.Message; }
        finally { isSubmitting = false; }
    }

    async Task Act(Func<Task> f)
    {
        if (isSubmitting) return;
        isSubmitting = true;
        actionMessage = null;
        actionError = null;
        try
        {
            await f();
            actionMessage = "Thành công";
            await LoadAsync();
            if (selected != null && Session.CurrentUser != null)
                selected = await DocService.GetByIdAsync(selected.Id, Session.CurrentUser.Id);
        }
        catch (Exception e)
        {
            actionError = e.Message;
            await LoadAsync();
            if (selected != null && Session.CurrentUser != null)
            {
                try { selected = await DocService.GetByIdAsync(selected.Id, Session.CurrentUser.Id); }
                catch (UnauthorizedAccessException) { selected = null; }
            }
        }
        finally { isSubmitting = false; }
    }

    string NoteOr(string fallback) => string.IsNullOrWhiteSpace(approvalNote) ? fallback : approvalNote.Trim();

    Task ApprovePkh() => Act(async () =>
    {
        var fallback = IsDirectPdv
            ? "SUP PKH đã duyệt và chuyển thẳng hồ sơ sang PDV"
            : "SUP PKH đã duyệt và chuyển hồ sơ sang PQLN";
        await DocService.PkhSupApproveAsync(selected!.Id, NoteOr(fallback), Session.CurrentUser!.Id);
        approvalNote = "";
    });
    Task ReceivePqln() => Act(() => DocService.PqlnTakeOwnershipAsync(selected!.Id, Session.CurrentUser!.Id));
    Task SubmitPqln() => Act(async () => { await DocService.PqlnSubmitSupAsync(selected!.Id, NoteOr("Kiểm tra và gửi SUP PQLN phê duyệt"), Session.CurrentUser!.Id); approvalNote = ""; });
    Task ApprovePqln() => Act(async () => { await DocService.PqlnSupApproveAsync(selected!.Id, NoteOr("SUP duyệt hồ sơ"), Session.CurrentUser!.Id); approvalNote = ""; });
    Task ReceivePdv() => Act(() => DocService.PdvTakeOwnershipAsync(selected!.Id, Session.CurrentUser!.Id));
    Task PostEntry() => Act(async () => { await DocService.PdvPostEntryAsync(selected!.Id, NoteOr("Thực hiện đi bút toán"), Session.CurrentUser!.Id); approvalNote = ""; });
    Task ApprovePdv() => Act(async () => { await DocService.PdvSupApproveAsync(selected!.Id, NoteOr("SUP PDV kiểm tra và duyệt hoàn tất"), Session.CurrentUser!.Id); approvalNote = ""; });
}