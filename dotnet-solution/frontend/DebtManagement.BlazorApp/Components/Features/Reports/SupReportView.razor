@using DebtManagement.Shared.DTOs
@using DebtManagement.Application.Interfaces
@using static DebtManagement.Shared.Constants.WorkflowConstants
@using static DebtManagement.BlazorApp.Models.DebtUiHelpers
@inject BlazorSession Session
@inject ISupReportService ReportService
@inject IJSRuntime JS

<div class="mb-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h4 class="fw-bold mb-1" style="letter-spacing: -0.3px;">
            Báo cáo giám sát chứng từ nợ — @(ActiveReportDept switch
            {
                DeptPkh => "Phòng Khách hàng (PKH)",
                DeptPqln => "Phòng Quản lý nợ (PQLN)",
                DeptPdv => "Phòng Dịch vụ khách hàng (PDV)",
                _ => "Phòng ban"
            })
        </h4>
        <p class="text-muted small mb-0">
            Theo dõi phân loại chứng từ nợ, tiến độ trả nợ liên phòng ban và trách nhiệm cán bộ xử lý.
        </p>
    </div>

    <div class="d-flex flex-wrap align-items-center gap-2">
        @if (Session.CurrentUser?.Role == RoleAdmin)
        {
            <div class="btn-group btn-group-sm" role="group">
                <button type="button"
                        class="btn @(adminPreviewDept == DeptPkh ? "btn-success" : "btn-outline-success")"
                        @onclick="() => SwitchAdminDeptAsync(DeptPkh)">
                    Góc nhìn PKH
                </button>
                <button type="button"
                        class="btn @(adminPreviewDept == DeptPqln ? "btn-success" : "btn-outline-success")"
                        @onclick="() => SwitchAdminDeptAsync(DeptPqln)">
                    Góc nhìn PQLN
                </button>
                <button type="button"
                        class="btn @(adminPreviewDept == DeptPdv ? "btn-success" : "btn-outline-success")"
                        @onclick="() => SwitchAdminDeptAsync(DeptPdv)">
                    Góc nhìn PDV
                </button>
            </div>
        }

        <button type="button"
                class="btn btn-sm bg-white border rounded-3 px-3 fw-medium"
                style="height: 36px;"
                @onclick="LoadReportAsync">
            ↻ Làm mới
        </button>
    </div>
</div>

@if (isLoading)
{
    <div class="vcb-surface p-5 text-center">
        <span class="spinner-border text-success"></span>
        <div class="text-muted small mt-2">Đang tổng hợp dữ liệu báo cáo...</div>
    </div>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger py-2 small rounded-3">@errorMessage</div>
}
else if (ActiveReportDept == DeptPkh && pkhReport != null)
{
    @RenderOriginatedReport(pkhReport, pkhOnTimePager, pkhOverduePager, isPqlnOriginated: false)
}
else if (ActiveReportDept == DeptPqln && pqlnReport != null)
{
    <div class="vcb-surface p-2 px-3 mb-3">
        <div class="vcb-tabs">
            <button type="button"
                    class="vcb-tab-btn @(pqlnTab == "received" ? "active" : "")"
                    @onclick='() => { pqlnTab = "received"; ResetFilters(); }'>
                <span>1. Tiếp nhận từ PKH</span>
                <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">
                    @pqlnReport.ReceivedFromPkh.TotalDocuments VB
                </span>
                @if (pqlnReport.ReceivedFromPkh.UnpaidItemsCount > 0)
                {
                    <span class="badge rounded-pill bg-danger" style="font-size: 11px;">
                        @pqlnReport.ReceivedFromPkh.UnpaidItemsCount CT chưa trả
                    </span>
                }
            </button>

            <button type="button"
                    class="vcb-tab-btn @(pqlnTab == "originated" ? "active" : "")"
                    @onclick='() => { pqlnTab = "originated"; ResetFilters(); }'>
                <span>2. Khởi tạo (Chuyển sang PDV)</span>
                <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">
                    @pqlnReport.OriginatedToPdv.TotalItems CT
                </span>
                @if (pqlnReport.OriginatedToPdv.OverdueUnpaidCount > 0)
                {
                    <span class="badge rounded-pill bg-danger" style="font-size: 11px;">
                        @pqlnReport.OriginatedToPdv.OverdueUnpaidCount quá hạn chưa trả
                    </span>
                }
            </button>
        </div>
    </div>

    @if (pqlnTab == "received")
    {
        @RenderPqlnReceivedReport(pqlnReport.ReceivedFromPkh)
    }
    else
    {
        @RenderOriginatedReport(pqlnReport.OriginatedToPdv, pqlnOnTimePager, pqlnOverduePager, isPqlnOriginated: true)
    }
}
else if (ActiveReportDept == DeptPdv && pdvReport != null)
{
    <div class="vcb-surface p-2 px-3 mb-3">
        <div class="vcb-tabs">
            <button type="button"
                    class="vcb-tab-btn @(pdvTab == "summary" ? "active" : "")"
                    @onclick='() => { pdvTab = "summary"; ResetFilters(); }'>
                <span>1. Tổng hợp các văn bản</span>
                <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">
                    @pdvReport.TotalDocuments VB
                </span>
                @if (pdvReport.DocumentsWithUnpaidDebt > 0)
                {
                    <span class="badge rounded-pill bg-warning text-dark" style="font-size: 11px;">
                        @pdvReport.DocumentsWithUnpaidDebt VB còn nợ CT
                    </span>
                }
            </button>

            <button type="button"
                    class="vcb-tab-btn @(pdvTab == "pkh_debt" ? "active" : "")"
                    @onclick='() => { pdvTab = "pkh_debt"; ResetFilters(); }'>
                <span>2. Nợ của PKH</span>
                <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">
                    @pdvReport.PkhTotalItems CT
                </span>
                @if (pdvReport.PkhUnpaidItems > 0)
                {
                    <span class="badge rounded-pill bg-danger" style="font-size: 11px;">
                        @pdvReport.PkhUnpaidItems chưa trả
                    </span>
                }
            </button>

            <button type="button"
                    class="vcb-tab-btn @(pdvTab == "pqln_debt" ? "active" : "")"
                    @onclick='() => { pdvTab = "pqln_debt"; ResetFilters(); }'>
                <span>3. Nợ của PQLN</span>
                <span class="badge rounded-pill bg-secondary-subtle text-dark" style="font-size: 11px;">
                    @pdvReport.PqlnTotalItems CT
                </span>
                @if (pdvReport.PqlnUnpaidItems > 0)
                {
                    <span class="badge rounded-pill bg-danger" style="font-size: 11px;">
                        @pdvReport.PqlnUnpaidItems chưa trả
                    </span>
                }
            </button>
        </div>
    </div>

    @if (pdvTab == "summary")
    {
        @RenderPdvDocumentSummary(pdvReport)
    }
    else if (pdvTab == "pkh_debt")
    {
        @RenderPdvDeptDebtList(pdvReport.PkhDebtItems, pdvPkhDebtPager, "PKH", isPkhSource: true)
    }
    else
    {
        @RenderPdvDeptDebtList(pdvReport.PqlnDebtItems, pdvPqlnDebtPager, "PQLN", isPkhSource: false)
    }
}
else
{
    <div class="vcb-surface p-5 text-center text-muted">
        Phân hệ báo cáo SUP chỉ áp dụng cho Lãnh đạo phòng (PKH, PQLN, PDV).
    </div>
}

@code {
    [Parameter] public EventCallback<Guid> OnSelectDocument { get; set; }

    sealed class TablePager
    {
        public int Page { get; set; } = 1;
        public int PageSize { get; set; } = 10;

        public List<T> Apply<T>(
            IReadOnlyList<T> source,
            out int totalItems,
            out int totalPages,
            out int startIndex,
            out int endIndex)
        {
            totalItems = source.Count;
            totalPages = Math.Max(1, (int)Math.Ceiling(totalItems / (double)PageSize));
            if (Page > totalPages) Page = totalPages;
            if (Page < 1) Page = 1;

            if (totalItems == 0)
            {
                startIndex = 0;
                endIndex = 0;
                return new List<T>();
            }

            startIndex = (Page - 1) * PageSize + 1;
            endIndex = Math.Min(totalItems, Page * PageSize);
            return source.Skip((Page - 1) * PageSize).Take(PageSize).ToList();
        }
    }

sealed class GroupedDebtDocument
    {
        public Guid DocumentId { get; init; }
        public string DocumentNumber { get; init; } = "";
        public string WorkflowType { get; init; } = "";
        public string CustomerName { get; init; } = "";
        public string? CustomerCif { get; init; }
        public string DocumentStatus { get; init; } = "";
        public string CreatedByName { get; init; } = "";
        public string OwedToDepartment { get; init; } = "";
        public string OwedToHandlerName { get; init; } = "";
        public string DueDate { get; init; } = "";
        public bool IsOverdue { get; init; }
        public int MaxOverdueDays { get; init; }
        public List<SupDebtItemReportRow> Items { get; init; } = new();
        public int PaidCount => Items.Count(x => x.IsPaid);
        public int UnpaidCount => Items.Count - PaidCount;
    }

    bool isLoading = true;
    bool groupByDocument = true; // Mặc định gom các chứng từ theo từng Hồ sơ / Văn bản
    string? errorMessage;
    string adminPreviewDept = DeptPkh;
    string pqlnTab = "received";
    string pdvTab = "summary";

    // Bộ lọc chung & riêng từng tab
    string searchText = "";
    string creatorFilter = "";
    string overdueSubFilter = "all";       // all | unpaid | paid
    string receivedStatusFilter = "all";   // all | unpaid | paid
    string pdvDocDebtFilter = "all";       // all | any_unpaid | pkh_unpaid | pqln_unpaid | fully_paid
    string pdvWorkflowFilter = "";         // "" | pkh_pqln_pdv | pkh_pdv
    string pdvDebtStatusFilter = "all";    // all | unpaid | paid | overdue_unpaid

    // 8 bộ phân trang độc lập cho toàn bộ các mục báo cáo của 3 phòng
    readonly TablePager pkhOnTimePager = new();
    readonly TablePager pkhOverduePager = new();
    readonly TablePager pqlnReceivedPager = new();
    readonly TablePager pqlnOnTimePager = new();
    readonly TablePager pqlnOverduePager = new();
    readonly TablePager pdvSummaryPager = new();
    readonly TablePager pdvPkhDebtPager = new();
    readonly TablePager pdvPqlnDebtPager = new();

    SupOriginatedDebtReportDto? pkhReport;
    SupPqlnFullReportDto? pqlnReport;
    SupPdvFullReportDto? pdvReport;

    string ActiveReportDept => Session.CurrentUser?.Role == RoleAdmin
        ? adminPreviewDept
        : (Session.CurrentUser?.DepartmentCode ?? "");

    protected override async Task OnInitializedAsync()
    {
        await LoadReportAsync();
    }

    void ResetAllPages()
    {
        pkhOnTimePager.Page = 1;
        pkhOverduePager.Page = 1;
        pqlnReceivedPager.Page = 1;
        pqlnOnTimePager.Page = 1;
        pqlnOverduePager.Page = 1;
        pdvSummaryPager.Page = 1;
        pdvPkhDebtPager.Page = 1;
        pdvPqlnDebtPager.Page = 1;
    }

    void ResetFilters()
    {
        searchText = "";
        creatorFilter = "";
        overdueSubFilter = "all";
        receivedStatusFilter = "all";
        pdvDocDebtFilter = "all";
        pdvWorkflowFilter = "";
        pdvDebtStatusFilter = "all";
        ResetAllPages();
    }

    async Task SwitchAdminDeptAsync(string dept)
    {
        adminPreviewDept = dept;
        ResetFilters();
        await LoadReportAsync();
    }

    async Task LoadReportAsync()
    {
        if (Session.CurrentUser == null) return;
        isLoading = true;
        errorMessage = null;
        try
        {
            if (ActiveReportDept == DeptPkh)
            {
                pkhReport = await ReportService.GetPkhSupReportAsync(Session.CurrentUser.Id);
            }
            else if (ActiveReportDept == DeptPqln)
            {
                pqlnReport = await ReportService.GetPqlnSupReportAsync(Session.CurrentUser.Id);
            }
            else if (ActiveReportDept == DeptPdv)
            {
                pdvReport = await ReportService.GetPdvSupReportAsync(Session.CurrentUser.Id);
            }
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    bool MatchRow(SupDebtItemReportRow r)
    {
        if (!string.IsNullOrEmpty(creatorFilter) && r.CreatedByName != creatorFilter)
            return false;

        if (!string.IsNullOrWhiteSpace(searchText))
        {
            var q = searchText.Trim().ToLower();
            var hit = r.DocumentNumber.ToLower().Contains(q)
                   || r.CustomerName.ToLower().Contains(q)
                   || (r.CustomerCif?.ToLower().Contains(q) ?? false)
                   || r.ItemName.ToLower().Contains(q)
                   || r.CreatedByName.ToLower().Contains(q)
                   || r.OwedToHandlerName.ToLower().Contains(q);
            if (!hit) return false;
        }
        return true;
    }

    static List<GroupedDebtDocument> GroupRowsByDocument(List<SupDebtItemReportRow> rows)
    {
        return rows
            .GroupBy(r => r.DocumentId)
            .Select(g =>
            {
                var first = g.First();
                var itemList = g.ToList();
                return new GroupedDebtDocument
                {
                    DocumentId = g.Key,
                    DocumentNumber = first.DocumentNumber,
                    WorkflowType = first.WorkflowType,
                    CustomerName = first.CustomerName,
                    CustomerCif = first.CustomerCif,
                    DocumentStatus = first.DocumentStatus,
                    CreatedByName = first.CreatedByName,
                    OwedToDepartment = first.OwedToDepartment,
                    OwedToHandlerName = first.OwedToHandlerName,
                    DueDate = first.DueDate ?? "",
                    IsOverdue = itemList.Any(x => x.IsOverdue),
                    MaxOverdueDays = itemList.Max(x => x.OverdueDays),
                    Items = itemList
                };
            })
            .ToList();
    }

    RenderFragment RenderGroupingToggle() => __builder =>
    {
        <div class="btn-group btn-group-sm" role="group" title="Chế độ hiển thị bảng dữ liệu">
            <button type="button"
                    class="btn @(groupByDocument ? "btn-success" : "btn-outline-secondary")"
                    style="height: 36px;"
                    @onclick="() => { groupByDocument = true; ResetAllPages(); }">
                🗂 Gom theo Hồ sơ
            </button>
            <button type="button"
                    class="btn @(!groupByDocument ? "btn-success" : "btn-outline-secondary")"
                    style="height: 36px;"
                    @onclick="() => { groupByDocument = false; ResetAllPages(); }">
                ☰ Tách từng chứng từ
            </button>
        </div>
    };

    RenderFragment RenderPaginationBar(
        TablePager pager,
        int totalItems,
        int totalPages,
        int startIndex,
        int endIndex,
        string unitLabel = "mục") => __builder =>
    {
        if (totalItems == 0) return;

        <div class="p-3 px-4 border-top d-flex flex-wrap justify-content-between align-items-center gap-2 bg-white">
            <div class="d-flex align-items-center gap-2 text-muted" style="font-size: 12.5px;">
                <span>
                    Hiển thị <b>@startIndex–@endIndex</b> / <b>@totalItems</b> @unitLabel
                </span>
                <select class="form-select form-select-sm rounded-3"
                        style="width: auto; height: 32px; font-size: 12.5px;"
                        value="@pager.PageSize"
                        @onchange="e => { if (int.TryParse(e.Value?.ToString(), out var sz)) { pager.PageSize = sz; pager.Page = 1; } }">
                    @foreach (var opt in PageSizeOptions)
                    {
                        <option value="@opt">@opt / trang</option>
                    }
                </select>
            </div>

            <nav aria-label="Phân trang báo cáo">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(pager.Page <= 1 ? "disabled" : "")">
                        <button type="button"
                                class="page-link"
                                style="color: #1f2937;"
                                disabled="@(pager.Page <= 1)"
                                @onclick="() => { if (pager.Page > 1) pager.Page--; }">
                            ‹ Trước
                        </button>
                    </li>

                    @foreach (var p in GetVisiblePages(pager.Page, totalPages))
                    {
                        if (p == null)
                        {
                            <li class="page-item disabled">
                                <span class="page-link">…</span>
                            </li>
                        }
                        else
                        {
                            var pageNum = p.Value;
                            var isActive = pageNum == pager.Page;
                            <li class="page-item @(isActive ? "active" : "")">
                                <button type="button"
                                        class="page-link"
                                        style="@(isActive ? "background-color: #0a7a42; border-color: #0a7a42; color: #fff; font-weight: 600;" : "color: #1f2937;")"
                                        @onclick="() => pager.Page = pageNum">
                                    @pageNum
                                </button>
                            </li>
                        }
                    }

                    <li class="page-item @(pager.Page >= totalPages ? "disabled" : "")">
                        <button type="button"
                                class="page-link"
                                style="color: #1f2937;"
                                disabled="@(pager.Page >= totalPages)"
                                @onclick="() => { if (pager.Page < totalPages) pager.Page++; }">
                            Sau ›
                        </button>
                    </li>
                </ul>
            </nav>
        </div>
    };

    RenderFragment RenderOriginatedReport(
        SupOriginatedDebtReportDto report,
        TablePager onTimePager,
        TablePager overduePager,
        bool isPqlnOriginated) => __builder =>
    {
        var allCreators = report.OnTimeItems
            .Concat(report.OverdueUnpaidItems)
            .Concat(report.OverduePaidItems)
            .Select(x => x.CreatedByName)
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        var filteredOnTime = report.OnTimeItems.Where(MatchRow).ToList();
        var filteredOverdueUnpaid = report.OverdueUnpaidItems.Where(MatchRow).ToList();
        var filteredOverduePaid = report.OverduePaidItems.Where(MatchRow).ToList();

        var filteredOverdueCombined = overdueSubFilter switch
        {
            "unpaid" => filteredOverdueUnpaid,
            "paid" => filteredOverduePaid,
            _ => filteredOverdueUnpaid.Concat(filteredOverduePaid).ToList()
        };

        <div class="vcb-kpi-grid-compact mb-3">
            <div class="vcb-kpi-btn">
                <div>
                    <div class="kpi-num">@report.TotalItems</div>
                    <div class="kpi-lbl">Tổng chứng từ nợ</div>
                </div>
                <div class="kpi-ico" style="background: #eaf5ee; color: #0a7a42;">📄</div>
            </div>

            <div class="vcb-kpi-btn">
                <div>
                    <div class="kpi-num text-success">@filteredOnTime.Count</div>
                    <div class="kpi-lbl">Nhóm 1: Đúng hạn</div>
                </div>
                <div class="kpi-ico" style="background: #e6f7ed; color: #0e8a4a;">✓</div>
            </div>

            <div class="vcb-kpi-btn">
                <div>
                    <div class="kpi-num text-danger">@filteredOverdueUnpaid.Count</div>
                    <div class="kpi-lbl">Quá hạn — Chưa trả</div>
                </div>
                <div class="kpi-ico" style="background: #fee2e2; color: #dc2626;">!</div>
            </div>

            <div class="vcb-kpi-btn">
                <div>
                    <div class="kpi-num text-warning">@filteredOverduePaid.Count</div>
                    <div class="kpi-lbl">Quá hạn — Đã trả</div>
                </div>
                <div class="kpi-ico" style="background: #fef3c7; color: #b45309;">⏱</div>
            </div>
        </div>

        <div class="vcb-surface p-3 px-4 mb-3">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <div class="vcb-input-wrap" style="width: 260px;">
                        <span class="vcb-input-icon" style="font-size: 13px;">🔍</span>
                        <input class="vcb-input" style="height: 36px; font-size: 13px;"
                               value="@searchText"
                               @oninput="e => { searchText = e.Value?.ToString() ?? string.Empty; onTimePager.Page = 1; overduePager.Page = 1; }"
                               placeholder="Tìm số VB, CIF, tên chứng từ..." />
                    </div>

                    <select class="form-select form-select-sm rounded-3" style="width: 210px; height: 36px;"
                            value="@creatorFilter"
                            @onchange="e => { creatorFilter = e.Value?.ToString() ?? string.Empty; onTimePager.Page = 1; overduePager.Page = 1; }">
                        <option value="">Tất cả cán bộ tạo (@allCreators.Count)</option>
                        @foreach (var c in allCreators)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>
                </div>

                <div class="d-flex flex-wrap align-items-center gap-2">
                    @RenderGroupingToggle()

                    <button type="button"
                            class="btn btn-sm bg-white border rounded-3 px-3 fw-medium"
                            style="height: 36px;"
                            @onclick="() => ExportOriginatedCsv(report, isPqlnOriginated)">
                        ⬇ Xuất CSV báo cáo
                    </button>
                </div>
            </div>
        </div>

        <div class="vcb-surface mb-4">
            <div class="p-3 px-4 border-bottom d-flex justify-content-between align-items-center" style="background: #f4fbf7;">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success rounded-pill">Nhóm 1</span>
                    <span class="fw-bold text-dark" style="font-size: 14.5px;">Chứng từ nợ Đúng hạn</span>
                    <span class="badge rounded-pill bg-success-subtle text-success border border-success-subtle">
                        @filteredOnTime.Count CT · @filteredOnTime.Select(x => x.DocumentId).Distinct().Count() VB
                    </span>
                </div>
                <span class="small text-muted">
                    Đã trả: <b>@filteredOnTime.Count(x => x.IsPaid)</b> · Chưa trả: <b>@filteredOnTime.Count(x => !x.IsPaid)</b>
                </span>
            </div>

            @RenderDebtItemReportTable(filteredOnTime, onTimePager, showOverdueColumn: false)
        </div>

        <div class="vcb-surface">
            <div class="p-3 px-4 border-bottom d-flex flex-wrap justify-content-between align-items-center gap-2" style="background: #fff8f8;">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-danger rounded-pill">Nhóm 2</span>
                    <span class="fw-bold text-dark" style="font-size: 14.5px;">Chứng từ nợ Quá hạn</span>
                    <span class="badge rounded-pill bg-danger-subtle text-danger border border-danger-subtle">
                        @(filteredOverdueUnpaid.Count + filteredOverduePaid.Count) CT · @filteredOverdueCombined.Select(x => x.DocumentId).Distinct().Count() VB
                    </span>
                </div>

                <div class="btn-group btn-group-sm" role="group">
                    <button type="button"
                            class="btn @(overdueSubFilter == "all" ? "btn-dark" : "btn-outline-secondary")"
                            @onclick='() => { overdueSubFilter = "all"; overduePager.Page = 1; }'>
                        Tất cả quá hạn (@(filteredOverdueUnpaid.Count + filteredOverduePaid.Count))
                    </button>
                    <button type="button"
                            class="btn @(overdueSubFilter == "unpaid" ? "btn-danger" : "btn-outline-danger")"
                            @onclick='() => { overdueSubFilter = "unpaid"; overduePager.Page = 1; }'>
                        Chưa trả (@filteredOverdueUnpaid.Count)
                    </button>
                    <button type="button"
                            class="btn @(overdueSubFilter == "paid" ? "btn-warning text-dark fw-semibold" : "btn-outline-warning text-dark")"
                            @onclick='() => { overdueSubFilter = "paid"; overduePager.Page = 1; }'>
                        Đã trả (@filteredOverduePaid.Count)
                    </button>
                </div>
            </div>

            @RenderDebtItemReportTable(filteredOverdueCombined, overduePager, showOverdueColumn: true)
        </div>
    };

    RenderFragment RenderDebtItemReportTable(
        List<SupDebtItemReportRow> rows,
        TablePager pager,
        bool showOverdueColumn) => __builder =>
    {
        if (rows.Count == 0)
        {
            <div class="p-4 text-center text-muted small">Không có chứng từ nợ nào trong mục này.</div>
            return;
        }

        if (groupByDocument)
        {
            var groupedDocs = GroupRowsByDocument(rows);
            var pagedDocs = pager.Apply(groupedDocs, out var totalDocs, out var totalPages, out var startIndex, out var endIndex);

            <div class="table-responsive">
                <table class="table vcb-table mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>HỒ SƠ / KHÁCH HÀNG</th>
                            <th>DANH SÁCH CHỨNG TỪ NỢ</th>
                            <th>CỦA AI TẠO</th>
                            <th>NỢ AI (ĐƠN VỊ NHẬN)</th>
                            <th>HẠN THANH TOÁN</th>
                            <th>TIẾN ĐỘ TRẢ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var g in pagedDocs)
                        {
                            <tr style="cursor: pointer;" @onclick="() => OnSelectDocument.InvokeAsync(g.DocumentId)">
