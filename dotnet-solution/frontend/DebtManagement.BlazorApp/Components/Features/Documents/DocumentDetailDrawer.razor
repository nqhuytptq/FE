@using DebtManagement.Shared.DTOs
@using DebtManagement.Application.Interfaces
@using static DebtManagement.BlazorApp.Models.DebtUiHelpers
@inject BlazorSession Session
@inject IDebtDocumentService DocService

@if (selected != null)
{
    var pkhItems = selected.DebtItems.Where(x => (x.SourceDepartmentCode ?? "PKH") == "PKH").ToList();
    var pqlnItems = selected.DebtItems.Where(x => x.SourceDepartmentCode == "PQLN").ToList();
    var completedItemsCount = selected.DebtItems.Count(x => IsItemFullyCompleted(x, IsDirectPdv));
    var totalPct = selected.DebtItems.Count == 0 ? 100 : (int)Math.Round(100.0 * completedItemsCount / selected.DebtItems.Count);
    var activeStepLabels = GetStepLabels(IsDirectPdv);
    var stepIdx = CurrentStepIndex(selected.Status, IsDirectPdv);

    <div class="vcb-backdrop" @onclick="CloseAsync">
        <div class="vcb-drawer" @onclick:stopPropagation="true">
            <div class="vcb-drawer-header">
                <button class="vcb-drawer-close" @onclick="CloseAsync">✕</button>
                <div class="d-flex align-items-center gap-2" style="font-family: monospace; font-size: 12px; opacity: 0.9;">
                    <span>@selected.DocumentNumber</span>
                    @if (!string.IsNullOrWhiteSpace(selected.CustomerCif))
                    {
                        <span>· CIF: @selected.CustomerCif</span>
                    }
                </div>
                <h4 class="fw-bold mb-2 mt-1">@selected.CustomerName</h4>
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(255,255,255,0.22); font-weight: 600;">
                        @(selected.CustomerType == "individual" ? "👤 Cá nhân" : "🏢 Công ty")
                    </span>
                    @if (IsDirectPdv)
                    {
                        <span class="badge rounded-pill px-3 py-1" style="background: rgba(255,255,255,0.25); font-weight: 600;">
                            ⚡ Chuyển thẳng PDV
                        </span>
                    }
                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(255,255,255,0.18); font-weight: 500;">
                        @selected.CurrentDepartmentName
                    </span>
                    <span class="badge rounded-pill bg-white text-success px-3 py-1 fw-semibold">
                        @StatusLabel(selected.Status)
                    </span>
                </div>
            </div>

            <div class="vcb-drawer-body">
                @if ((St is "ReturnedToPkh" or "ReturnedToPqln") && !string.IsNullOrWhiteSpace(selected.ReturnReason))
                {
                    <div class="alert alert-danger border-danger-subtle py-2 px-3 mb-3 small">
                        <div class="fw-bold mb-1">
                            ↩ Hồ sơ đã bị trả lại từ @selected.ReturnedFromDepartmentCode bởi @(selected.ReturnedByUserName ?? "—")
                            @if (selected.ReturnedAt.HasValue)
                            {
                                <span class="fw-normal">(@FormatFullVnTime(selected.ReturnedAt.Value))</span>
                            }
                        </div>
                        <div>Lý do: <b>@selected.ReturnReason</b></div>
                    </div>
                }

                @if (CanEditDocumentInfo)
                {
                    <div class="mb-3">
                        @if (!isEditingDocInfo)
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-3 fw-semibold" @onclick="StartEditDocInfo">
                                ✏️ Sửa thông tin hồ sơ
                            </button>
                        }
                        else
                        {
                            <div class="vcb-surface p-3 border border-primary-subtle rounded-3">
                                <div class="fw-bold small mb-2 text-primary">Chỉnh sửa thông tin hồ sơ</div>
                                <div class="row g-2 small">
                                    <div class="col-md-6">
                                        <label class="form-label mb-1">Tên khách hàng *</label>
                                        <input class="form-control form-control-sm" @bind="editCustomerName" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label mb-1">Mã CIF</label>
                                        <input class="form-control form-control-sm" @bind="editCustomerCif" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label mb-1">Đối tượng</label>
                                        <select class="form-select form-select-sm" @bind="editCustomerType">
                                            <option value="company">Công ty</option>
                                            <option value="individual">Cá nhân</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label mb-1">Hạn thanh toán *</label>
                                        <input type="date" class="form-control form-control-sm" @bind="editDueDateValue" />
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label mb-1">Độ ưu tiên</label>
                                        <select class="form-select form-select-sm" @bind="editPriority">
                                            <option value="low">Thấp</option>
                                            <option value="normal">Bình thường</option>
                                            <option value="high">Cao</option>
                                            <option value="urgent">Khẩn</option>
                                        </select>
                                    </div>
                                    @if (Dept == "PKH" && St is "PkhPendingSup" or "ReturnedToPkh")
                                    {
                                        <div class="col-md-6">
                                            <label class="form-label mb-1">Luồng xử lý</label>
                                            <select class="form-select form-select-sm" @bind="editWorkflowType">
                                                <option value="pkh_pqln_pdv">Chuẩn (PKH → PQLN → PDV)</option>
                                                <option value="pkh_pdv">Chuyển thẳng (PKH → PDV)</option>
                                            </select>
                                        </div>
                                    }
                                    <div class="col-12">
                                        <label class="form-label mb-1">Ghi chú</label>
                                        <input class="form-control form-control-sm" @bind="editDocNotes" />
                                    </div>
                                </div>
                                <div class="d-flex gap-2 mt-2">
                                    <button type="button" class="btn btn-sm btn-primary fw-semibold" disabled="@isSubmitting" @onclick="SaveEditDocInfo">
                                        💾 Lưu thông tin
                                    </button>
                                    <button type="button" class="btn btn-sm btn-light border" @onclick="() => isEditingDocInfo = false">
                                        Hủy
                                    </button>
                                </div>
                            </div>
                        }
                    </div>
                }

                @if (actionError != null)
                {
                    <div class="alert alert-danger py-2 small mb-3">@actionError</div>
                }
                @if (actionMessage != null)
                {
                    <div class="alert alert-success py-2 small mb-3">@actionMessage</div>
                }

                <div class="vcb-stepper">
                    @for (int idx = 0; idx < activeStepLabels.Length; idx++)
                    {
                        var sNumber = idx + 1;
                        var css = sNumber < stepIdx ? "done" : (sNumber == stepIdx ? (selected.Status == "Completed" ? "done" : "current") : "");
                        <div class="vcb-step @css">
                            <div class="vcb-step-circle">
                                @if (sNumber < stepIdx || (sNumber == activeStepLabels.Length && selected.Status == "Completed"))
                                {
                                    <span>✓</span>
                                }
                                else
                                {
                                    <span>@sNumber</span>
                                }
                            </div>
                            <div class="vcb-step-label">@activeStepLabels[idx]</div>
                        </div>
                    }
                </div>

                <div class="vcb-surface p-3 mb-3 small">
                    <div class="row g-2">
                        <div class="col-md-6">
                            <span class="text-muted">Mã CIF:</span> <b>@(string.IsNullOrWhiteSpace(selected.CustomerCif) ? "—" : selected.CustomerCif)</b>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Đối tượng:</span> <b>@(selected.CustomerType == "individual" ? "Khách hàng Cá nhân" : "Khách hàng Công ty")</b>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Luồng xử lý:</span>
                            <b>@(IsDirectPdv ? "Chuyển thẳng PDV (PKH → PDV)" : "Tiêu chuẩn (PKH → PQLN → PDV)")</b>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">Hạn thanh toán:</span> <b class="text-danger">@FormatDate(selected.DueDate)</b>
                        </div>
                        <div class="col-md-6">
                            <span class="text-muted">PKH khởi tạo:</span> <b>@(selected.CreatedByUserName ?? "—")</b>
                        </div>
                        @if (!IsDirectPdv)
                        {
                            <div class="col-md-6">
                                <span class="text-muted">PQLN xử lý:</span> <b>@(selected.PqlnReceiverName ?? "Chưa nhận")</b>
                            </div>
                        }
                        <div class="col-md-6">
                            <span class="text-muted">PDV xử lý:</span> <b>@(selected.PdvReceiverName ?? "Chưa nhận")</b>
                        </div>
                    </div>
                </div>

                <div class="vcb-surface p-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold" style="font-size: 14.5px;">Chứng từ nợ</span>
                        <span class="small text-muted fw-semibold">
                            @(selected.DebtItems.Count == 0 ? "Không có" : $"{completedItemsCount}/{selected.DebtItems.Count} đã đủ")
                        </span>
                    </div>
                    <div class="vcb-progress-track w-100 mb-3" style="height: 5px;">
                        <div class="vcb-progress-fill" style="width: @(totalPct)%;"></div>
                    </div>

                    <div class="row g-3">
                        <div class="@(IsDirectPdv ? "col-12" : "col-md-6")">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.4px;">
                                    CHỨNG TỪ PKH
                                </span>
                                <span class="small text-muted fw-semibold" style="font-size: 11px;">
                                    @(IsDirectPdv
                                        ? pkhItems.Count(x => x.IsSupplemented && x.IsVerifiedByPdv)
                                        : pkhItems.Count(x => x.IsSupplemented && x.IsVerifiedByPqln))/@pkhItems.Count
                                </span>
                            </div>

                            @if (pkhItems.Count == 0)
                            {
                                <div class="text-muted small py-2">Không có chứng từ nợ PKH</div>
                            }
                            @foreach (var it in pkhItems)
                            {
                                var isVerified = IsDirectPdv ? it.IsVerifiedByPdv : it.IsVerifiedByPqln;
                                var verifiedAt = IsDirectPdv ? it.PdvVerifiedAt : it.PqlnVerifiedAt;
                                var verifierDept = IsDirectPdv ? "PDV" : "PQLN";
                                var isRejected = !it.IsSupplemented && !string.IsNullOrWhiteSpace(it.LastRejectReason);

                                <div class="vcb-item-row">
                                    @if (editingItemId == it.Id)
                                    {
                                        <input class="form-control form-control-sm" @bind="editItemName" />
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-success py-0" @onclick="() => SaveEditItem(it)">Lưu</button>
                                            <button class="btn btn-sm btn-secondary py-0" @onclick="CancelEditItem">Hủy</button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div>
                                            <div class="small fw-semibold">📄 @it.ItemName</div>
                                            @if (isRejected)
                                            {
                                                <div class="text-danger mt-1" style="font-size: 11.5px;">
                                                    ↩ Bị từ chối bởi @it.RejectedByDepartmentCode (@(it.RejectedByUserName ?? "—")): <b>@it.LastRejectReason</b>
                                                    @if (it.RejectedAt.HasValue)
                                                    {
                                                        <span class="text-muted"> · @FormatFullVnTime(it.RejectedAt.Value)</span>
                                                    }
                                                </div>
                                            }
                                            @if (it.IsSupplemented)
                                            {
                                                <div class="text-muted mt-1" style="font-size: 11.5px;">
                                                    PKH bổ sung: <b>@(it.SupplementedAt.HasValue ? FormatFullVnTime(it.SupplementedAt.Value) : "—")</b>
                                                    @if (isVerified)
                                                    {
                                                        <span class="text-success d-block">@verifierDept xác nhận: <b>@(verifiedAt.HasValue ? FormatFullVnTime(verifiedAt.Value) : "—")</b></span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-primary d-block"><i>Chờ @verifierDept xác nhận đã nhận</i></span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                            @if (isRejected)
                                            {
                                                <span class="vcb-status-pill" style="font-size: 11.5px; padding: 2px 10px; background:#fde8e8; color:#b91c1c; border-color:#f8b4b4;">
                                                    <span class="dot" style="background:#dc2626;"></span>Bị từ chối
                                                </span>
                                            }
                                            else if (!it.IsSupplemented)
                                            {
                                                <span class="vcb-status-pill pill-amber" style="font-size: 11.5px; padding: 2px 10px;">
                                                    <span class="dot"></span>Chưa bổ sung
                                                </span>
                                            }
                                            else if (!isVerified)
                                            {
                                                <span class="vcb-status-pill pill-blue" style="font-size: 11.5px; padding: 2px 10px;">
                                                    <span class="dot"></span>Chờ @verifierDept XN
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="vcb-status-pill pill-green" style="font-size: 11.5px; padding: 2px 10px;">
                                                    <span class="dot"></span>Đã bổ sung
                                                </span>
                                            }
                                            @if (CanManagePkhItem && !it.IsSupplemented)
                                            {
                                                <div class="d-flex gap-1">
                                                    <button class="btn btn-link btn-sm p-0 text-primary text-decoration-none" style="font-size: 11.5px;" @onclick="() => StartEditItem(it)">Sửa</button>
                                                    <span class="text-muted">·</span>
                                                    <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none" style="font-size: 11.5px;" @onclick="() => DeleteDebtItem(it.Id)">Xóa</button>
                                                </div>
                                            }
                                            @if (it.IsSupplemented && !isVerified && CanVerifyPkhSupplement && rejectingItemId != it.Id)
                                            {
                                                <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 11px;"
                                                        @onclick="() => StartRejectItem(it.Id)">
                                                    ↩ Từ chối
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (rejectingItemId == it.Id)
                                {
                                    <div class="p-2 mb-2 rounded-3 border border-danger-subtle bg-danger-subtle">
                                        <div class="small fw-semibold text-danger mb-1">Từ chối bổ sung "@it.ItemName"</div>
                                        <div class="d-flex gap-2">
                                            <input class="form-control form-control-sm" @bind="rejectItemReason" placeholder="Nhập lý do từ chối (bắt buộc)..." />
                                            <button type="button" class="btn btn-sm btn-danger flex-shrink-0" disabled="@isSubmitting" @onclick="() => ConfirmRejectItem(it.Id)">
                                                Xác nhận
                                            </button>
                                            <button type="button" class="btn btn-sm btn-light border flex-shrink-0" @onclick="CancelRejectItem">
                                                Hủy
                                            </button>
                                        </div>
                                    </div>
                                }
                            }

                            @if (CanManagePkhItem)
                            {
                                <div class="d-flex gap-2 mt-2">
                                    <input class="form-control form-control-sm rounded-3" @bind="addItemName" placeholder="Tên chứng từ PKH..." />
                                    <button class="btn btn-sm btn-outline-success rounded-3 fw-semibold flex-shrink-0" @onclick="AddDebtItem">+ Thêm</button>
                                </div>
                            }
                        </div>

                        @if (!IsDirectPdv)
                        {
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="text-uppercase fw-bold text-muted" style="font-size: 11px; letter-spacing: 0.4px;">
                                        CHỨNG TỪ PQLN
                                    </span>
                                    <span class="small text-muted fw-semibold" style="font-size: 11px;">
                                        @pqlnItems.Count(x => x.IsSupplemented && x.IsVerifiedByPdv)/@pqlnItems.Count
                                    </span>
                                </div>

                                @if (pqlnItems.Count == 0 && !CanManagePqlnItem)
                                {
                                    <div class="text-muted small py-2">Không có chứng từ nợ PQLN</div>
                                }
                                @foreach (var it in pqlnItems)
                                {
                                    var isRejected = !it.IsSupplemented && !string.IsNullOrWhiteSpace(it.LastRejectReason);

                                    <div class="vcb-item-row">
                                        @if (editingItemId == it.Id)
                                        {
                                            <input class="form-control form-control-sm" @bind="editItemName" />
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-success py-0" @onclick="() => SaveEditItem(it)">Lưu</button>
                                                <button class="btn btn-sm btn-secondary py-0" @onclick="CancelEditItem">Hủy</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <div class="small fw-semibold">📄 @it.ItemName</div>
                                                @if (isRejected)
                                                {
                                                    <div class="text-danger mt-1" style="font-size: 11.5px;">
                                                        ↩ Bị từ chối bởi @it.RejectedByDepartmentCode (@(it.RejectedByUserName ?? "—")): <b>@it.LastRejectReason</b>
                                                        @if (it.RejectedAt.HasValue)
                                                        {
                                                            <span class="text-muted"> · @FormatFullVnTime(it.RejectedAt.Value)</span>
                                                        }
                                                    </div>
                                                }
                                                @if (it.IsSupplemented)
                                                {
                                                    <div class="text-muted mt-1" style="font-size: 11.5px;">
                                                        PQLN bổ sung: <b>@(it.SupplementedAt.HasValue ? FormatFullVnTime(it.SupplementedAt.Value) : "—")</b>
                                                        @if (it.IsVerifiedByPdv)
                                                        {
                                                            <span class="text-success d-block">PDV xác nhận: <b>@(it.PdvVerifiedAt.HasValue ? FormatFullVnTime(it.PdvVerifiedAt.Value) : "—")</b></span>
                                                        }
                                                        else
                                                        {
                                                            <span class="text-primary d-block"><i>Chờ PDV xác nhận đã nhận</i></span>
                                                        }
                                                    </div>
                                                }
                                            </div>
                                            <div class="d-flex flex-column align-items-end gap-1 flex-shrink-0">
                                                @if (isRejected)
                                                {
                                                    <span class="vcb-status-pill" style="font-size: 11.5px; padding: 2px 10px; background:#fde8e8; color:#b91c1c; border-color:#f8b4b4;">
                                                        <span class="dot" style="background:#dc2626;"></span>Bị từ chối
                                                    </span>
                                                }
                                                else if (!it.IsSupplemented)
                                                {
                                                    <span class="vcb-status-pill pill-amber" style="font-size: 11.5px; padding: 2px 10px;">
                                                        <span class="dot"></span>Chưa bổ sung
                                                    </span>
                                                }
                                                else if (!it.IsVerifiedByPdv)
                                                {
                                                    <span class="vcb-status-pill pill-blue" style="font-size: 11.5px; padding: 2px 10px;">
                                                        <span class="dot"></span>Chờ PDV XN
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="vcb-status-pill pill-green" style="font-size: 11.5px; padding: 2px 10px;">
                                                        <span class="dot"></span>Đã bổ sung
                                                    </span>
                                                }
                                                @if (CanManagePqlnItem && !it.IsSupplemented)
                                                {
                                                    <div class="d-flex gap-1">
                                                        <button class="btn btn-link btn-sm p-0 text-primary text-decoration-none" style="font-size: 11.5px;" @onclick="() => StartEditItem(it)">Sửa</button>
                                                        <span class="text-muted">·</span>
                                                        <button class="btn btn-link btn-sm p-0 text-danger text-decoration-none" style="font-size: 11.5px;" @onclick="() => DeleteDebtItem(it.Id)">Xóa</button>
                                                    </div>
                                                }
                                                @if (it.IsSupplemented && !it.IsVerifiedByPdv && CanVerifyPqlnSupplement && rejectingItemId != it.Id)
                                                {
                                                    <button type="button" class="btn btn-outline-danger btn-sm py-0 px-2" style="font-size: 11px;"
                                                            @onclick="() => StartRejectItem(it.Id)">
                                                        ↩ Từ chối
                                                    </button>
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (rejectingItemId == it.Id)
                                    {
                                        <div class="p-2 mb-2 rounded-3 border border-danger-subtle bg-danger-subtle">
                                            <div class="small fw-semibold text-danger mb-1">Từ chối bổ sung "@it.ItemName"</div>
                                            <div class="d-flex gap-2">
                                                <input class="form-control form-control-sm" @bind="rejectItemReason" placeholder="Nhập lý do từ chối (bắt buộc)..." />
                                                <button type="button" class="btn btn-sm btn-danger flex-shrink-0" disabled="@isSubmitting" @onclick="() => ConfirmRejectItem(it.Id)">
                                                    Xác nhận
                                                </button>
                                                <button type="button" class="btn btn-sm btn-light border flex-shrink-0" @onclick="CancelRejectItem">
                                                    Hủy
                                                </button>
                                            </div>
                                        </div>
                                    }
                                }

                                @if (CanManagePqlnItem)
                                {
                                    <div class="d-flex gap-2 mt-2">
                                        <input class="form-control form-control-sm rounded-3" @bind="addItemName" placeholder="Tên chứng từ PQLN..." />
                                        <button class="btn btn-sm btn-outline-success rounded-3 fw-semibold flex-shrink-0" @onclick="AddDebtItem">+ Thêm</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>

                    @if (SupplementableItems.Any())
                    {
                        <div class="mt-3 p-2 rounded-3 border border-success bg-success-subtle">
                            <div class="small fw-semibold text-success-emphasis mb-1">Đánh dấu đã bổ sung chứng từ (@Dept):</div>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var it in SupplementableItems)
                                {
                                    <div class="form-check small">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@suppIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleSupp(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label">@it.ItemName</label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-success mt-2 fw-semibold" @onclick="SupplementItems" disabled="@(suppIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận bổ sung (@suppIds.Count)
                            </button>
                        </div>
                    }

                    @if (VerifiablePkhItems.Any())
                    {
                        <div class="mt-3 p-2 rounded-3 border border-info bg-info-subtle">
                            <div class="small fw-semibold text-info-emphasis mb-1">
                                @(IsDirectPdv ? "PDV xác nhận đã nhận chứng từ từ PKH:" : "PQLN xác nhận đã nhận chứng từ từ PKH:")
                            </div>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var it in VerifiablePkhItems)
                                {
                                    <div class="form-check small">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@verifyIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleVerify(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label">@it.ItemName</label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-primary mt-2 fw-semibold" @onclick="VerifyPkhItems" disabled="@(verifyIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận đã nhận từ PKH (@verifyIds.Count)
                            </button>
                        </div>
                    }

                    @if (VerifiablePqlnItems.Any())
                    {
                        <div class="mt-3 p-2 rounded-3 border border-primary bg-primary-subtle">
                            <div class="small fw-semibold text-primary-emphasis mb-1">PDV xác nhận đã nhận chứng từ từ PQLN:</div>
                            <div class="d-flex flex-wrap gap-3">
                                @foreach (var it in VerifiablePqlnItems)
                                {
                                    <div class="form-check small">
                                        <input class="form-check-input" type="checkbox"
                                               checked="@verifyPqlnIds.Contains(it.Id)"
                                               @onchange="(e) => ToggleVerifyPqln(it.Id, (bool)(e.Value ?? false))" />
                                        <label class="form-check-label">@it.ItemName</label>
                                    </div>
                                }
                            </div>
                            <button class="btn btn-sm btn-primary mt-2 fw-semibold" @onclick="VerifyPqlnItems" disabled="@(verifyPqlnIds.Count == 0 || isSubmitting)">
                                ✓ Xác nhận đã nhận từ PQLN (@verifyPqlnIds.Count)
                            </button>
                        </div>
                    }
                </div>

                @{
                    var orderedHistory = selected.CirculationHistory
                        .OrderByDescending(x => x.CreatedAt)
                        .ToList();
                }
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="fw-bold" style="font-size: 15px;">Luồng theo dõi</span>
                    <span class="text-muted" style="font-size: 11.5px;">Mới nhất ở trên</span>
                </div>

                <div class="vcb-surface p-3 px-4">
                    <div class="vcb-timeline">
                        @for (int i = 0; i < orderedHistory.Count; i++)
                        {
                            var h = orderedHistory[i];
                            var isLatest = i == 0;
                            var deptFlow = FormatHistoryDeptFlow(h);

                            <div class="vcb-tl-item @(isLatest ? "latest" : "")">
                                <span class="vcb-tl-dot"></span>

                                <div class="d-flex flex-wrap align-items-baseline gap-2">
                                    <span class="vcb-tl-title">@FormatHistoryActionLabel(h)</span>
                                    <span class="vcb-tl-time">@FormatFullVnTime(h.CreatedAt)</span>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(h.Notes))
                                {
                                    <div class="vcb-tl-note">@h.Notes</div>
                                }

                                <div class="vcb-tl-meta">
                                    <span>👤 @h.PerformedByUserName</span>
                                    @if (!string.IsNullOrEmpty(deptFlow))
                                    {
                                        <span>·</span>
                                        <span>@deptFlow</span>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (showReturnPanel && ReturnTargets.Count > 0)
            {
                <div class="p-3 border-top bg-danger-subtle">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="fw-bold small text-danger">↩ Trả lại hồ sơ</span>
                        <button type="button" class="btn-close" style="font-size: 10px;" @onclick="CancelReturnPanel"></button>
                    </div>

                    @if (ReturnTargets.Count > 1)
                    {
                        <div class="d-flex flex-wrap gap-3 mb-2 small">
                            @foreach (var tgt in ReturnTargets)
                            {
                                <label class="form-check-label d-flex align-items-center gap-1" style="cursor: pointer;">
                                    <input class="form-check-input mt-0" type="radio" name="returnTarget"
                                           checked="@(returnTargetCode == tgt.Code)"
                                           @onchange="() => returnTargetCode = tgt.Code" />
                                    <span class="fw-semibold">@tgt.Label</span>
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="small mb-2">Đích trả về: <b>@ReturnTargets[0].Label</b></div>
                    }

                    <div class="d-flex gap-2">
                        <input class="form-control form-control-sm" @bind="returnReasonInput" placeholder="Nhập lý do trả lại hồ sơ (bắt buộc)..." />
                        <button type="button" class="btn btn-sm btn-danger fw-semibold flex-shrink-0" disabled="@isSubmitting" @onclick="ConfirmReturnDocument">
                            Xác nhận trả lại
                        </button>
                    </div>
                </div>
            }

            <div class="vcb-drawer-footer">
                @if (CanResubmitPkh)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Giải trình chỉnh sửa trước khi gửi lại..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ResubmitPkh">
                        📤 Gửi lại SUP PKH →
                    </button>
                }
                else if (CanApprovePkh)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú duyệt PKH..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ApprovePkh">
                        ✓ Duyệt hồ sơ PKH →
                    </button>
                }
                else if (CanReceivePqln)
                {
                    <span class="small text-muted">Hồ sơ đang chờ phòng PQLN tiếp nhận</span>
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ReceivePqln">
                        Tiếp nhận hồ sơ PQLN
                    </button>
                }
                else if (CanSubmitPqln)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú trình SUP PQLN..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="SubmitPqln">
                        ➤ Trình SUP PQLN
                    </button>
                }
                else if (CanApprovePqln)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú duyệt PQLN..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ApprovePqln">
                        ✓ Duyệt hồ sơ PQLN →
                    </button>
                }
                else if (CanReceivePdv)
                {
                    <span class="small text-muted">Hồ sơ đang chờ phòng PDV tiếp nhận</span>
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="ReceivePdv">
                        Tiếp nhận hồ sơ PDV
                    </button>
                }
                else if (CanPostEntry)
                {
                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú đi bút toán..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@isSubmitting" @onclick="PostEntry">
                        Xác nhận đi bút toán →
                    </button>
                }
                else if (CanApprovePdv)
                {
                    var unsupCount = selected.DebtItems.Count(x => !IsItemFullyCompleted(x, IsDirectPdv));
                    var blocked = St == "PdvEntryApproved" && unsupCount > 0;
                    var btnLabel = St == "PdvEntryPosted"
                        ? (unsupCount > 0 ? "✓ Duyệt bút toán (Lần 1)" : "✓ Duyệt hoàn tất hồ sơ")
                        : "✓ Duyệt hoàn tất (Lần 2)";

                    <input class="form-control form-control-sm" @bind="approvalNote" placeholder="Ghi chú duyệt PDV..." />
                    <button class="vcb-btn-primary px-3 flex-shrink-0" style="height: 38px;" disabled="@(isSubmitting || blocked)" @onclick="ApprovePdv">
                        @btnLabel
                    </button>
                }
                else
                {
                    <span class="small text-muted">@GetFooterStatusHint(selected)</span>
                    <button type="button" class="btn btn-sm bg-white border rounded-3 px-3 flex-shrink-0" style="height: 36px;" @onclick="CloseAsync">
                        Đóng
                    </button>
                }

                @if (ReturnTargets.Count > 0 && !showReturnPanel)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-3 px-3 flex-shrink-0 fw-semibold" style="height: 38px;"
                            disabled="@isSubmitting" @onclick="OpenReturnPanel">
                        ↩ Trả lại
                    </button>
                }
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public Guid? DocumentId { get; set; }
    [Parameter] public EventCallback OnDocumentChanged { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    Guid? loadedDocumentId;
    DebtDocumentDetailDto? selected;
    string? actionMessage;
    string? actionError;
    bool isSubmitting;
    string addItemName = "";
    string approvalNote = "";
    HashSet<Guid> suppIds = new();
    HashSet<Guid> verifyIds = new();
    HashSet<Guid> verifyPqlnIds = new();
    Guid? editingItemId;
    string editItemName = "";

    // Sửa thông tin hồ sơ
    bool isEditingDocInfo;
    string editCustomerName = "";
    string? editCustomerCif;
    string editCustomerType = "company";
    string editWorkflowType = "pkh_pqln_pdv";
    DateOnly editDueDateValue;
    string editPriority = "normal";
    string? editDocNotes;

    // Kịch bản A: Trả lại hồ sơ
    bool showReturnPanel;
    string returnTargetCode = "";
    string returnReasonInput = "";

    // Kịch bản B: Từ chối chứng từ bổ sung
    Guid? rejectingItemId;
    string rejectItemReason = "";

    record ReturnTargetOption(string Code, string Label);

    static readonly string[] StandardStepLabels =
    [
        "Khởi tạo",
        "SUP PKH duyệt",
        "PQLN đang xử lý",
        "SUP PQLN duyệt",
        "PDV đang xử lý",
        "SUP PDV duyệt",
        "Hoàn tất"
    ];

    static readonly string[] DirectPdvStepLabels =
    [
        "Khởi tạo",
        "SUP PKH duyệt",
        "PDV đang xử lý",
        "SUP PDV duyệt",
        "Hoàn tất"
    ];

    static string[] GetStepLabels(bool isDirectPdv)
        => isDirectPdv ? DirectPdvStepLabels : StandardStepLabels;

    static int CurrentStepIndex(string status, bool isDirectPdv) => isDirectPdv
        ? status switch
        {
            "PkhPendingSup" or "ReturnedToPkh" => 1,
            "PdvPendingReceive" => 2,
            "PdvReceived" or "PdvEntryPosted" => 3,
            "PdvEntryApproved" => 4,
            "Completed" => 5,
            _ => 1
        }
        : status switch
        {
            "PkhPendingSup" or "ReturnedToPkh" => 1,
            "PqlnPendingReceive" => 2,
            "PqlnReceived" or "PqlnPendingSup" or "ReturnedToPqln" => 3,
            "PdvPendingReceive" => 4,
            "PdvReceived" or "PdvEntryPosted" => 5,
            "PdvEntryApproved" => 6,
            "Completed" => 7,
            _ => 1
        };

    string Dept => Session.CurrentUser?.DepartmentCode ?? "";
    string St => selected?.Status ?? "";
    bool IsDirectPdv => selected?.WorkflowType == "pkh_pdv";
    bool R(string r) => Session.CurrentUser?.Role == r;

    bool CanResubmitPkh => selected != null && Dept == "PKH" && R("staff") && St == "ReturnedToPkh" && selected.CreatedByUserId == Session.CurrentUser?.Id;
    bool CanApprovePkh => selected != null && Dept == "PKH" && R("manager") && St == "PkhPendingSup";
    bool CanReceivePqln => selected != null && !IsDirectPdv && Dept == "PQLN" && R("staff") && St == "PqlnPendingReceive";
    bool CanSubmitPqln => selected != null && !IsDirectPdv && Dept == "PQLN" && R("staff") && (St is "PqlnReceived" or "ReturnedToPqln") && selected.PqlnReceiverId == Session.CurrentUser?.Id;
    bool CanApprovePqln => selected != null && !IsDirectPdv && Dept == "PQLN" && R("manager") && St == "PqlnPendingSup";
    bool CanReceivePdv => selected != null && Dept == "PDV" && R("staff") && St == "PdvPendingReceive";
    bool CanPostEntry => selected != null && Dept == "PDV" && R("staff") && St == "PdvReceived" && selected.PdvReceiverId == Session.CurrentUser?.Id;
    bool CanApprovePdv => selected != null && Dept == "PDV" && R("manager") && (St == "PdvEntryPosted" || St == "PdvEntryApproved");

    bool CanEditDocumentInfo => selected != null && Session.CurrentUser != null && R("staff")
        && ((Dept == "PKH" && selected.CreatedByUserId == Session.CurrentUser.Id && St is "PkhPendingSup" or "ReturnedToPkh")
            || (!IsDirectPdv && Dept == "PQLN" && selected.PqlnReceiverId == Session.CurrentUser.Id && St is "PqlnReceived" or "ReturnedToPqln"));

    List<ReturnTargetOption> ReturnTargets
    {
        get
        {
            var list = new List<ReturnTargetOption>();
            if (selected == null || Session.CurrentUser == null) return list;

            if (Dept == "PKH" && R("manager") && St == "PkhPendingSup")
                list.Add(new("PKH", "Trả về nhân viên PKH"));

            if (!IsDirectPdv && Dept == "PQLN")
            {
                if (R("staff") && (St == "PqlnPendingReceive" || (St is "PqlnReceived" or "ReturnedToPqln" && selected.PqlnReceiverId == Session.CurrentUser.Id)))
                    list.Add(new("PKH", "Trả về PKH"));

                if (R("manager") && St == "PqlnPendingSup")
                {
                    list.Add(new("PQLN", "Trả về nhân viên PQLN"));
                    list.Add(new("PKH", "Trả về PKH"));
                }
            }

            if (Dept == "PDV")
            {
                var pdvCanReturn = (R("staff") && (St == "PdvPendingReceive" || (St == "PdvReceived" && selected.PdvReceiverId == Session.CurrentUser.Id)))
                                || (R("manager") && St == "PdvEntryPosted");
                if (pdvCanReturn)
                {
                    if (!IsDirectPdv)
                        list.Add(new("PQLN", "Trả về PQLN"));
                    list.Add(new("PKH", IsDirectPdv ? "Trả về PKH" : "Trả thẳng về PKH"));
                }
            }

            return list;
        }
    }

    bool CanSupplement => selected != null
        && Session.CurrentUser != null
        && R("staff")
        && ((Dept == "PKH" && selected.CreatedByUserId == Session.CurrentUser.Id)
            || (!IsDirectPdv && Dept == "PQLN" && selected.PqlnReceiverId == Session.CurrentUser.Id));

    IEnumerable<DebtItemDto> SupplementableItems => selected == null || !CanSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => !x.IsSupplemented && (x.SourceDepartmentCode ?? "PKH") == Dept);

    bool CanVerifyPkhSupplement => selected != null
        && Session.CurrentUser != null
        && R("staff")
        && (IsDirectPdv
            ? (Dept == "PDV" && selected.PdvReceiverId == Session.CurrentUser.Id)
            : (Dept == "PQLN" && selected.PqlnReceiverId == Session.CurrentUser.Id));

    IEnumerable<DebtItemDto> VerifiablePkhItems => selected == null || !CanVerifyPkhSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => (x.SourceDepartmentCode ?? "PKH") == "PKH"
                                     && x.IsSupplemented
                                     && (IsDirectPdv ? !x.IsVerifiedByPdv : !x.IsVerifiedByPqln));

    bool CanVerifyPqlnSupplement => selected != null
        && !IsDirectPdv
        && Session.CurrentUser != null
        && R("staff")
        && Dept == "PDV"
        && selected.PdvReceiverId == Session.CurrentUser.Id;

    IEnumerable<DebtItemDto> VerifiablePqlnItems => selected == null || !CanVerifyPqlnSupplement
        ? Enumerable.Empty<DebtItemDto>()
        : selected.DebtItems.Where(x => x.SourceDepartmentCode == "PQLN"
                                     && x.IsSupplemented
                                     && !x.IsVerifiedByPdv);

    bool CanManagePkhItem => selected != null && Dept == "PKH" && R("staff") && (St is "PkhPendingSup" or "ReturnedToPkh") && selected.CreatedByUserId == Session.CurrentUser?.Id;
    bool CanManagePqlnItem => selected != null && !IsDirectPdv && Dept == "PQLN" && R("staff") && (St is "PqlnReceived" or "PqlnPendingSup" or "ReturnedToPqln") && selected.PqlnReceiverId == Session.CurrentUser?.Id;

    protected override async Task OnParametersSetAsync()
    {
        if (DocumentId == null)
        {
            loadedDocumentId = null;
            selected = null;
            return;
        }

        if (DocumentId != loadedDocumentId)
        {
            loadedDocumentId = DocumentId;
            await ReloadSelectedAsync(resetState: true);
        }
    }

    async Task ReloadSelectedAsync(bool resetState)
    {
        if (resetState)
        {
            suppIds.Clear();
            verifyIds.Clear();
            verifyPqlnIds.Clear();
            approvalNote = "";
            isEditingDocInfo = false;
            CancelEditItem();
            CancelReturnPanel();
            CancelRejectItem();
            actionMessage = null;
            actionError = null;
        }

        if (DocumentId.HasValue && Session.CurrentUser != null)
            selected = await DocService.GetByIdAsync(DocumentId.Value, Session.CurrentUser.Id);
    }

    async Task CloseAsync()
    {
        isEditingDocInfo = false;
        CancelEditItem();
        CancelReturnPanel();
        CancelRejectItem();
        approvalNote = "";
        suppIds.Clear();
        verifyIds.Clear();
        verifyPqlnIds.Clear();
        loadedDocumentId = null;
        selected = null;
        await OnClose.InvokeAsync();
    }

    string GetFooterStatusHint(DebtDocumentDetailDto d) => d.Status switch
    {
        "PkhPendingSup" => "Đang chờ Lãnh đạo PKH (SUP PKH) phê duyệt",
        "ReturnedToPkh" => "Hồ sơ đang bị trả về PKH để chỉnh sửa và gửi lại",
        "PqlnPendingReceive" => "Đã duyệt PKH — Đang chờ cán bộ PQLN tiếp nhận",
        "PqlnReceived" => $"Đang được {d.PqlnReceiverName ?? "cán bộ PQLN"} thụ lý",
        "ReturnedToPqln" => $"Hồ sơ bị trả về PQLN để {d.PqlnReceiverName ?? "cán bộ PQLN"} xử lý lại",
        "PqlnPendingSup" => "Đang chờ Lãnh đạo PQLN (SUP PQLN) phê duyệt",
        "PdvPendingReceive" => d.WorkflowType == "pkh_pdv"
            ? "Đã duyệt PKH — Đang chờ cán bộ PDV tiếp nhận"
            : "Đã duyệt PQLN — Đang chờ cán bộ PDV tiếp nhận",
        "PdvReceived" => $"Đang được {d.PdvReceiverName ?? "cán bộ PDV"} thụ lý & đi bút toán",
        "PdvEntryPosted" => "Đã đi bút toán — Đang chờ Lãnh đạo PDV duyệt",
        "PdvEntryApproved" => "Đã duyệt bút toán — Đang chờ bổ sung & xác nhận đủ chứng từ nợ",
        "Completed" => "Hồ sơ đã hoàn tất toàn bộ quy trình",
        _ => "Hồ sơ đang ở bước xử lý khác"
    };

    string FormatHistoryActionLabel(CirculationHistoryDto h)
    {
        var note = (h.Notes ?? "").ToLower();
        if (note.Contains("từ chối chứng từ")) return "Từ chối chứng từ";
        if (note.Contains("trả lại hồ sơ") || h.Action == "Returned") return "Trả lại hồ sơ";
        if (note.Contains("gửi lại sup pkh")) return "PKH gửi lại";
        if (note.Contains("khởi tạo")) return "Khởi tạo";
        if (h.Action == "PkhSupApproved" || note.Contains("sup pkh") || (note.Contains("sup duyệt") && (IsDirectPdv || note.Contains("khách hàng")))) return "SUP PKH duyệt";
        if (note.Contains("sup duyệt")) return "SUP duyệt";
        if (note.Contains("tiếp nhận") && note.Contains("pqln")) return "PQLN tiếp nhận";
        if (note.Contains("tiếp nhận") && note.Contains("pdv")) return "PDV tiếp nhận";
        if (note.Contains("gửi sup pqln") || note.Contains("trình sup pqln")) return "Trình SUP PQLN";
        if (note.Contains("bút toán") && note.Contains("duyệt")) return "SUP PDV duyệt";
        if (note.Contains("bút toán")) return "Đi bút toán";
        if (note.Contains("hoàn tất")) return "Duyệt hoàn tất";
        if (note.Contains("xác nhận") && note.Contains("chứng từ")) return "Xác nhận chứng từ";
        if (note.Contains("bổ sung")) return "Bổ sung";
        if (note.Contains("sửa tên chứng từ") || note.Contains("sửa chứng từ")) return "Sửa chứng từ";
        if (note.Contains("xóa chứng từ")) return "Xóa chứng từ";
        if (note.Contains("thêm chứng từ")) return "Thêm chứng từ";
        return "Cập nhật hồ sơ";
    }

    string FormatHistoryDeptFlow(CirculationHistoryDto h)
    {
        if (h.FromDepartmentId.HasValue && h.ToDepartmentId.HasValue && h.FromDepartmentId != h.ToDepartmentId
            && !string.IsNullOrWhiteSpace(h.FromDepartmentName) && !string.IsNullOrWhiteSpace(h.ToDepartmentName))
        {
            return $"{h.FromDepartmentName} → {h.ToDepartmentName}";
        }

        var note = (h.Notes ?? "").Trim().ToLower();

        if (note.Contains("khởi tạo")) return "Phòng Khách hàng";

        if (note.Contains("sup duyệt") || h.Action is "PkhSupApproved" or "PqlnSupApproved")
        {
            if (IsDirectPdv || h.Action == "PqlnSupApproved")
                return h.Action == "PqlnSupApproved"
                    ? "Phòng Quản lý nợ → Phòng Dịch vụ khách hàng"
                    : "Phòng Khách hàng → Phòng Dịch vụ khách hàng";

            return "Phòng Khách hàng → Phòng Quản lý nợ";
        }

        // Ưu tiên bắt đúng phòng của người thực hiện theo tiền tố ghi chú
        if (note.StartsWith("nv pkh") || note.StartsWith("sup pkh") || note.StartsWith("[nv pkh") || note.StartsWith("[sup pkh") || note.Contains("tại pkh"))
            return "Phòng Khách hàng";

        if (note.StartsWith("nv pqln") || note.StartsWith("sup pqln") || note.StartsWith("[nv pqln") || note.StartsWith("[sup pqln") || note.Contains("tại pqln"))
            return "Phòng Quản lý nợ";

        if (note.StartsWith("nv pdv") || note.StartsWith("sup pdv") || note.StartsWith("[nv pdv") || note.StartsWith("[sup pdv") || note.Contains("tại pdv"))
            return "Phòng Dịch vụ khách hàng";

        // Bắt theo Action nghiệp vụ của từng phòng
        if (h.Action is "PqlnReceived" or "PqlnSubmittedSup")
            return "Phòng Quản lý nợ";

        if (h.Action is "PdvReceived" or "PdvEntryPosted" or "PdvSupApprovedEntry" or "Completed")
            return "Phòng Dịch vụ khách hàng";

        if (note.Contains("pdv") || note.Contains("bút toán")) return "Phòng Dịch vụ khách hàng";
        if (note.Contains("pqln")) return "Phòng Quản lý nợ";
        if (note.Contains("pkh")) return "Phòng Khách hàng";

        if (selected != null)
        {
            var supApprovals = selected.CirculationHistory
                .Where(x => (x.Notes ?? "").ToLower().Contains("sup duyệt") || x.Action is "PkhSupApproved" or "PqlnSupApproved")
                .OrderBy(x => x.CreatedAt)
                .ToList();

            if (IsDirectPdv)
            {
                if (supApprovals.Count >= 1 && h.CreatedAt > supApprovals[0].CreatedAt)
                    return "Phòng Dịch vụ khách hàng";
            }
            else
            {
                if (supApprovals.Count >= 2 && h.CreatedAt > supApprovals[1].CreatedAt)
                    return "Phòng Dịch vụ khách hàng";
                if (supApprovals.Count >= 1 && h.CreatedAt > supApprovals[0].CreatedAt)
                    return "Phòng Quản lý nợ";
            }
        }

        return "Phòng Khách hàng";
    }

    void StartEditDocInfo()
    {
        if (selected == null) return;
        editCustomerName = selected.CustomerName;
        editCustomerCif = selected.CustomerCif;
        editCustomerType = selected.CustomerType;
        editWorkflowType = selected.WorkflowType;
        editDueDateValue = DateOnly.TryParse(selected.DueDate, out var dt) ? dt : DateOnly.FromDateTime(DateTime.UtcNow.AddHours(7));
        editPriority = selected.Priority;
        editDocNotes = selected.Notes;
        isEditingDocInfo = true;
    }

    async Task SaveEditDocInfo()
    {
        if (selected == null || Session.CurrentUser == null) return;
        if (string.IsNullOrWhiteSpace(editCustomerName))
        {
            actionError = "Tên khách hàng không được để trống.";
            return;
        }

        await Act(async () =>
        {
            await DocService.UpdateAsync(selected.Id, new UpdateDebtDocumentRequest
            {
                CustomerName = editCustomerName.Trim(),
                CustomerCif = editCustomerCif,
                CustomerType = editCustomerType,
                WorkflowType = editWorkflowType,
                IssueDate = selected.IssueDate,
                DueDate = editDueDateValue.ToString("yyyy-MM-dd"),
                Priority = editPriority,
                Notes = editDocNotes,
                HasDebtDocuments = selected.HasDebtDocuments,
                DebtItems = null
            }, Session.CurrentUser.Id);
            isEditingDocInfo = false;
        });
    }

