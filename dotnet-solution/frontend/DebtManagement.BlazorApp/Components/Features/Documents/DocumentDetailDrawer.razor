    async Task Act(Func<Task> f)
    {
        if (isSubmitting) return;
        isSubmitting = true;
        actionMessage = null;
        actionError = null;
        try
        {
            await f();
            actionMessage = "Thành công";
            await OnDocumentChanged.InvokeAsync();
            await ReloadSelectedAsync(resetState: false);
        }
        catch (Exception e)
        {
            actionError = e.Message;
            await OnDocumentChanged.InvokeAsync();
            try { await ReloadSelectedAsync(resetState: false); }
            catch (UnauthorizedAccessException) { await CloseAsync(); }
        }
        finally { isSubmitting = false; }
    }

    string NoteOr(string fallback) => string.IsNullOrWhiteSpace(approvalNote) ? fallback : approvalNote.Trim();

